{"documento": "CN.D23", "archivo": "4_modificacion_obras_convenios/Resolucion-N_-4465-2007.pdf", "lineas": [{"i": 0, "pag": 1, "texto": "GOBIERNO DE CHILE", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 1, "pag": 1, "texto": "MINISTERIO DE OBRAS PUBLICAS", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 2, "pag": 1, "texto": "MINISTERIO DE HACIENDA", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 3, "pag": 1, "texto": "OFICINA DE PARTES", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 4, "pag": 1, "texto": "4465", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 5, "pag": 1, "texto": "RECIBIDO", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 6, "pag": 1, "texto": "31 DIC 2007", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 7, "pag": 1, "texto": "Ref.: Modifica por razones de interés", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 8, "pag": 1, "texto": "público y urgencia, obras y servicios", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 9, "pag": 1, "texto": "que indica en la obra pública fiscal", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 10, "pag": 1, "texto": "denominada \"Concesión Internacional", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 11, "pag": 1, "texto": "Sistema Oriente-Poniente\".", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 12, "pag": 1, "texto": "CONTRALORIA GENERAL", "conf": null, "fuente": "vlm", "parrafo": 2, "marginal": false}, {"i": 13, "pag": 1, "texto": "TOMA DE RAZON", "conf": null, "fuente": "vlm", "parrafo": 2, "marginal": false}, {"i": 14, "pag": 1, "texto": "SANTIAGO, 2 8 DIC 2007", "conf": null, "fuente": "vlm", "parrafo": 3, "marginal": false}, {"i": 15, "pag": 1, "texto": "RECEPCION", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 16, "pag": 1, "texto": "VISTOS: - El DFL MOP Nº 850, de 1997, que fijó", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 17, "pag": 1, "texto": "el texto refundido, coordinado y", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 18, "pag": 1, "texto": "sistematizado de la Ley Nº 15.840, de", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 19, "pag": 1, "texto": "1964, Orgánica del Ministerio de Obras", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 20, "pag": 1, "texto": "Públicas y del DFL Nº 206, de 1960, Ley", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 21, "pag": 1, "texto": "de Caminos.", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 22, "pag": 1, "texto": "DEPART. JURIDICO |  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 23, "pag": 1, "texto": "DEP. T. R. Y REGISTRO |  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 24, "pag": 1, "texto": "DEPART. CONTABIL. |  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 25, "pag": 1, "texto": "SUB. DEP. C. CENTRAL |  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 26, "pag": 1, "texto": "SUB. DEP. E. CUENTAS |  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 27, "pag": 1, "texto": "SUB. DEP. C. P. Y BIENES NAC. |  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 28, "pag": 1, "texto": "DEPART. AUDITORIA |  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 29, "pag": 1, "texto": "DEPART. V. O. P., U y T. |  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 30, "pag": 1, "texto": "SUB. DEP. MUNICIP. |  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 31, "pag": 1, "texto": "|  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 32, "pag": 1, "texto": "|  |", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 33, "pag": 1, "texto": "- El Decreto Supremo MOP Nº 900, de", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 34, "pag": 1, "texto": "1996, que fijó el texto refundido,", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 35, "pag": 1, "texto": "coordinado y sistematizado del DFL", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 36, "pag": 1, "texto": "MOP Nº 164, de 1991, Ley de", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 37, "pag": 1, "texto": "Concesiones de Obras Públicas, y en", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 38, "pag": 1, "texto": "particular su artículo 19º.", "conf": null, "fuente": "vlm", "parrafo": 4, "marginal": false}, {"i": 39, "pag": 1, "texto": "- El Decreto Supremo MOP Nº 956, de", "conf": null, "fuente": "vlm", "parrafo": 5, "marginal": false}, {"i": 40, "pag": 1, "texto": "1997, Reglamento de la Ley de", "conf": null, "fuente": "vlm", "parrafo": 5, "marginal": false}, {"i": 41, "pag": 1, "texto": "Concesiones, en especial el artículo 69º.", "conf": null, "fuente": "vlm", "parrafo": 5, "marginal": false}, {"i": 42, "pag": 1, "texto": "- El Decreto Supremo MOP Nº 375, de", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 43, "pag": 1, "texto": "fecha 24 de febrero de 2000, que", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 44, "pag": 1, "texto": "adjudicó el contrato de concesión para la", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 45, "pag": 1, "texto": "ejecución, conservación y explotación de", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 46, "pag": 1, "texto": "la obra pública fiscal denominada", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 47, "pag": 1, "texto": "\"Concesión Internacional Sistema", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 48, "pag": 1, "texto": "Oriente-Poniente\".", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 49, "pag": 1, "texto": "REFRENDACION", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 50, "pag": 1, "texto": "REF. POR $ __________", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 51, "pag": 1, "texto": "IMPUTAC. __________", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 52, "pag": 1, "texto": "ANOT. POR $ __________", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 53, "pag": 1, "texto": "IMPUTAC. __________", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 54, "pag": 1, "texto": "DEDUC DTO. __________", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 55, "pag": 1, "texto": "- El Decreto Supremo MOP Nº 1079 de", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 56, "pag": 1, "texto": "fecha 13 de julio de 2001, que aprobó el", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 57, "pag": 1, "texto": "convenio complementario Nº 1 de fecha", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 58, "pag": 1, "texto": "26 de junio de 2001 que modificó el", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 59, "pag": 1, "texto": "contrato de concesión de la obra pública", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 60, "pag": 1, "texto": "fiscal denominada \"Concesión", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 61, "pag": 1, "texto": "Internacional Sistema Oriente -", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 62, "pag": 1, "texto": "Poniente\".", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 63, "pag": 1, "texto": "Nº Proceso: 1788506", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 64, "pag": 2, "texto": "- El Decreto Supremo MOP Nº 1397 de fecha 28 de septiembre de 2001, que aprobó el", "conf": null, "fuente": "vlm", "parrafo": 8, "marginal": false}, {"i": 65, "pag": 2, "texto": "Convenio Complementario Nº 2 de fecha 14 de septiembre de 2001, que modificó el", "conf": null, "fuente": "vlm", "parrafo": 8, "marginal": false}, {"i": 66, "pag": 2, "texto": "contrato de concesión de la obra pública fiscal denominada \"Concesión Internacional", "conf": null, "fuente": "vlm", "parrafo": 8, "marginal": false}, {"i": 67, "pag": 2, "texto": "Sistema Oriente – Poniente\".", "conf": null, "fuente": "vlm", "parrafo": 8, "marginal": false}, {"i": 68, "pag": 2, "texto": "- El Decreto Supremo MOP Nº 559 de fecha 30 de mayo de 2003, que aprobó los", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 69, "pag": 2, "texto": "Convenios Complementarios Nº 3 y Nº 4 de fechas 6 de diciembre de 2002 y 29 de mayo", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 70, "pag": 2, "texto": "de 2003, que modificaron el contrato de concesión de la obra pública fiscal denominada", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 71, "pag": 2, "texto": "\"Concesión Internacional Sistema Oriente – Poniente\".", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 72, "pag": 2, "texto": "- El Decreto Supremo MOP Nº 228 de fecha 11 de abril de 2005, que aprobó el Convenio", "conf": null, "fuente": "vlm", "parrafo": 10, "marginal": false}, {"i": 73, "pag": 2, "texto": "Complementario Nº 5 de fecha 31 de marzo de 2005, que modificó el contrato de", "conf": null, "fuente": "vlm", "parrafo": 10, "marginal": false}, {"i": 74, "pag": 2, "texto": "concesión de la obra pública fiscal denominada \"Concesión Internacional Sistema Oriente", "conf": null, "fuente": "vlm", "parrafo": 10, "marginal": false}, {"i": 75, "pag": 2, "texto": "– Poniente\".", "conf": null, "fuente": "vlm", "parrafo": 10, "marginal": false}, {"i": 76, "pag": 2, "texto": "- El Decreto Supremo MOP Nº 503 de fecha 25 de julio de 2007, que aprobó el Convenio", "conf": null, "fuente": "vlm", "parrafo": 11, "marginal": false}, {"i": 77, "pag": 2, "texto": "Complementario Nº 6 de fecha 11 de julio de 2007, que modificó el contrato de concesión", "conf": null, "fuente": "vlm", "parrafo": 11, "marginal": false}, {"i": 78, "pag": 2, "texto": "de la obra pública fiscal denominada \"Concesión Internacional Sistema Oriente –", "conf": null, "fuente": "vlm", "parrafo": 11, "marginal": false}, {"i": 79, "pag": 2, "texto": "Poniente\".", "conf": null, "fuente": "vlm", "parrafo": 11, "marginal": false}, {"i": 80, "pag": 2, "texto": "- La Resolución Nº 520 de 1996 de la Contraloría General de la República que fijó el texto", "conf": null, "fuente": "vlm", "parrafo": 12, "marginal": false}, {"i": 81, "pag": 2, "texto": "refundido, coordinado y sistematizado de la Resolución Nº 55 de 1992.", "conf": null, "fuente": "vlm", "parrafo": 12, "marginal": false}, {"i": 82, "pag": 2, "texto": "CONSIDERANDO:", "conf": null, "fuente": "vlm", "parrafo": 13, "marginal": false}, {"i": 83, "pag": 2, "texto": "- Que los artículos Nº 19 de la Ley de Concesiones de Obras Públicas y Nº 69, en especial", "conf": null, "fuente": "vlm", "parrafo": 14, "marginal": false}, {"i": 84, "pag": 2, "texto": "Nº 4, del Reglamento de dicha Ley establece que el Ministerio de Obras Públicas, desde", "conf": null, "fuente": "vlm", "parrafo": 14, "marginal": false}, {"i": 85, "pag": 2, "texto": "que se perfeccione el contrato, podrá modificar, por razones de urgencia, las", "conf": null, "fuente": "vlm", "parrafo": 14, "marginal": false}, {"i": 86, "pag": 2, "texto": "características de las obras y servicios contratados.", "conf": null, "fuente": "vlm", "parrafo": 14, "marginal": false}, {"i": 87, "pag": 2, "texto": "- Que se ha estimado de interés público ejecutar la obra denominada \"Pintura Exterior de 11", "conf": null, "fuente": "vlm", "parrafo": 15, "marginal": false}, {"i": 88, "pag": 2, "texto": "Edificios de Villa Ríos\", toda vez que los restantes edificios de la misma Villa fueron", "conf": null, "fuente": "vlm", "parrafo": 15, "marginal": false}, {"i": 89, "pag": 2, "texto": "pintados para mitigar los efectos de la construcción del Sistema Norte Sur, quedando estos", "conf": null, "fuente": "vlm", "parrafo": 15, "marginal": false}, {"i": 90, "pag": 2, "texto": "11 edificios que serán pintados para mitigar los efectos de la construcción del Sistema", "conf": null, "fuente": "vlm", "parrafo": 15, "marginal": false}, {"i": 91, "pag": 2, "texto": "Oriente Poniente, de manera que todos los edificios de Villa Ríos recuperen su situación", "conf": null, "fuente": "vlm", "parrafo": 15, "marginal": false}, {"i": 92, "pag": 2, "texto": "en el entorno urbano.", "conf": null, "fuente": "vlm", "parrafo": 15, "marginal": false}, {"i": 93, "pag": 2, "texto": "- Que por las razones de interés público expresadas precedentemente y teniendo en cuenta", "conf": null, "fuente": "vlm", "parrafo": 16, "marginal": false}, {"i": 94, "pag": 2, "texto": "que la suscripción y tramitación de un convenio complementario sobre la materia implica", "conf": null, "fuente": "vlm", "parrafo": 16, "marginal": false}, {"i": 95, "pag": 2, "texto": "tiempos superiores a los requeridos, es que se ha hecho necesaria la dictación del presente", "conf": null, "fuente": "vlm", "parrafo": 16, "marginal": false}, {"i": 96, "pag": 2, "texto": "acto administrativo, sin perjuicio de la regulación de todos sus efectos mediante el", "conf": null, "fuente": "vlm", "parrafo": 16, "marginal": false}, {"i": 97, "pag": 2, "texto": "Convenio Complementario que para el efecto suscribirán las partes del contrato de", "conf": null, "fuente": "vlm", "parrafo": 16, "marginal": false}, {"i": 98, "pag": 2, "texto": "concesión.", "conf": null, "fuente": "vlm", "parrafo": 16, "marginal": false}, {"i": 99, "pag": 2, "texto": "2", "conf": null, "fuente": "vlm", "parrafo": 17, "marginal": true}, {"i": 100, "pag": 3, "texto": "RESUELVO:", "conf": null, "fuente": "vlm", "parrafo": 18, "marginal": false}, {"i": 101, "pag": 3, "texto": "DGOP N° 4465 / (Exento)", "conf": null, "fuente": "vlm", "parrafo": 19, "marginal": false}, {"i": 102, "pag": 3, "texto": "1. ESTABLÉCESE que \"Sociedad Concesionaria Costanera Norte S.A.\" deberá ejecutar la obra del cuadro siguiente:", "conf": null, "fuente": "vlm", "parrafo": 20, "marginal": false}, {"i": 103, "pag": 3, "texto": "Obra | Monto", "conf": null, "fuente": "vlm", "parrafo": 21, "marginal": false}, {"i": 104, "pag": 3, "texto": "Pintura exterior de 11 edificios de Villa Rios | (UF)", "conf": null, "fuente": "vlm", "parrafo": 21, "marginal": false}, {"i": 105, "pag": 3, "texto": "Pintura exterior de 11 edificios de Villa Rios | 4.312,66", "conf": null, "fuente": "vlm", "parrafo": 21, "marginal": false}, {"i": 106, "pag": 3, "texto": "El valor total por la ejecución de esta obra se fija en el monto neto de IVA y a suma alzada de UF 4.312,66 (Cuatro Mil Trescientas Doce Coma Sesenta y Seis Unidades de Fomento).", "conf": null, "fuente": "vlm", "parrafo": 21, "marginal": false}, {"i": 107, "pag": 3, "texto": "El pago a la Sociedad Concesionaria de las mayores inversiones antes señaladas será convenido y se estipulará en el respectivo Convenio Complementario.", "conf": null, "fuente": "vlm", "parrafo": 22, "marginal": false}, {"i": 108, "pag": 3, "texto": "2. ESTABLÉCESE que la Sociedad Concesionaria deberá ejecutar la obra singularizada en el número 1 anterior, en el plazo de 6 meses contados desde la fecha de la total tramitación de la presente Resolución.", "conf": null, "fuente": "vlm", "parrafo": 23, "marginal": false}, {"i": 109, "pag": 3, "texto": "En caso de atraso en la ejecución de la obra, respecto al plazo máximo que se establece, se aplicará a la Sociedad Concesionaria una multa diaria, para la obra atrasada, de 5 UTM por cada día de atraso. La ejecución de la obra deberá cumplir con los estándares y requisitos señalados en las Bases de Licitación y demás instrumentos que forman parte del contrato de concesión.", "conf": null, "fuente": "vlm", "parrafo": 24, "marginal": false}, {"i": 110, "pag": 3, "texto": "3. ESTABLÉCESE que el cumplimiento de las funciones encomendadas estará caucionado por las boletas de garantía de explotación vigentes del contrato de concesión, en la proporción correspondiente.", "conf": null, "fuente": "vlm", "parrafo": 25, "marginal": false}, {"i": 111, "pag": 3, "texto": "4. ESTABLÉCESE que las modificaciones de obras y servicios de que trata la presente resolución y las demás condiciones particulares derivadas de la misma, serán materia de un Convenio Complementario que para el efecto suscribirán las partes del contrato de concesión.", "conf": null, "fuente": "vlm", "parrafo": 26, "marginal": false}, {"i": 112, "pag": 3, "texto": "5. ESTABLÉCESE que dentro del plazo de 10 días hábiles contados desde la fecha de tramitación de la presente Resolución, tres transcripciones de ésta deberán ser suscritas ante Notario por \"Sociedad Concesionaria Costanera Norte S.A.\" en señal de aceptación de su contenido, debiendo protocolizar ante el mismo uno de los ejemplares. Dentro de los cinco días hábiles siguientes, dos de las transcripciones debidamente suscritas deberán entregarse, una en la Oficina de Partes de la Dirección General de Obras Públicas y otra en la Coordinación de Concesiones de Obras Públicas, ambas con una copia autorizada de la protocolización efectuada.", "conf": null, "fuente": "vlm", "parrafo": 27, "marginal": false}, {"i": 113, "pag": 3, "texto": "3", "conf": null, "fuente": "vlm", "parrafo": 28, "marginal": true}, {"i": 114, "pag": 4, "texto": "6. COMUNÍQUESE la presente Resolución a \"Sociedad Concesionaria Costanera Norte", "conf": null, "fuente": "vlm", "parrafo": 29, "marginal": false}, {"i": 115, "pag": 4, "texto": "S.A.\", a la Dirección General de Obras Públicas, a la Coordinación de Concesiones de", "conf": null, "fuente": "vlm", "parrafo": 29, "marginal": false}, {"i": 116, "pag": 4, "texto": "Obras Públicas a la División de Explotación de Obras Viales, al Inspector Fiscal de la", "conf": null, "fuente": "vlm", "parrafo": 29, "marginal": false}, {"i": 117, "pag": 4, "texto": "obra y demás servicios que corresponda.", "conf": null, "fuente": "vlm", "parrafo": 29, "marginal": false}, {"i": 118, "pag": 4, "texto": "ANÓTESE Y COMUNÍQUESE", "conf": null, "fuente": "vlm", "parrafo": 30, "marginal": false}, {"i": 119, "pag": 4, "texto": "PATRICIO AGUILERA POBLETE", "conf": null, "fuente": "vlm", "parrafo": 31, "marginal": false}, {"i": 120, "pag": 4, "texto": "INGENIERO CIVIL", "conf": null, "fuente": "vlm", "parrafo": 31, "marginal": false}, {"i": 121, "pag": 4, "texto": "Director General de Obras Públicas", "conf": null, "fuente": "vlm", "parrafo": 31, "marginal": false}, {"i": 122, "pag": 4, "texto": "REPUBLICA DE CHILE", "conf": null, "fuente": "vlm", "parrafo": 32, "marginal": false}, {"i": 123, "pag": 4, "texto": "MINISTERIO DE OBRAS PUBLICAS", "conf": null, "fuente": "vlm", "parrafo": 32, "marginal": false}, {"i": 124, "pag": 4, "texto": "MINISTRO", "conf": null, "fuente": "vlm", "parrafo": 32, "marginal": false}, {"i": 125, "pag": 4, "texto": "V° B° Sr. Ministro de Obras Públicas", "conf": null, "fuente": "vlm", "parrafo": 32, "marginal": false}, {"i": 126, "pag": 4, "texto": "REPUBLICA DE CHILE", "conf": null, "fuente": "vlm", "parrafo": 33, "marginal": false}, {"i": 127, "pag": 4, "texto": "MINISTRO", "conf": null, "fuente": "vlm", "parrafo": 33, "marginal": false}, {"i": 128, "pag": 4, "texto": "MINISTERIO DE HACIENDA", "conf": null, "fuente": "vlm", "parrafo": 33, "marginal": false}, {"i": 129, "pag": 4, "texto": "V° B° Sr. Ministro de Hacienda.", "conf": null, "fuente": "vlm", "parrafo": 33, "marginal": false}, {"i": 130, "pag": 4, "texto": "4", "conf": null, "fuente": "vlm", "parrafo": 34, "marginal": true}]}