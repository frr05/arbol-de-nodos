{"documento": "AVO.D05", "archivo": "1_licitacion/AVOII-Precal-Circular-Aclaratoria-N_4.pdf", "lineas": [{"i": 0, "pag": 1, "texto": "REPÚBLICA DE CHILE", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 1, "pag": 1, "texto": "MINISTERIO DE OBRAS PÚBLICAS", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": true}, {"i": 2, "pag": 1, "texto": "DIRECCIÓN GENERAL DE OBRAS PÚBLICAS", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": true}, {"i": 3, "pag": 1, "texto": "EN TRAMITE SIN", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 4, "pag": 1, "texto": "VALOR OFICIAL", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 5, "pag": 1, "texto": "194", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 6, "pag": 1, "texto": "REF.: Aprueba Circular Aclaratoria Nº 4 de las Bases de", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 7, "pag": 1, "texto": "Precalificación del Registro Especial Internacional", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 8, "pag": 1, "texto": "“Proyectos de Concesiones de Américo Vespucio", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 9, "pag": 1, "texto": "Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 10, "pag": 1, "texto": "MINISTERIO DE HACIENDA", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 11, "pag": 1, "texto": "OFICINA DE PARTES", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 12, "pag": 1, "texto": "RECIBIDO", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 13, "pag": 1, "texto": "SANTIAGO, 31 AGO 2011", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 14, "pag": 1, "texto": "VISTOS:", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 15, "pag": 1, "texto": "El DFL MOP Nº 850 de 1997, que fija el texto refundido,", "co