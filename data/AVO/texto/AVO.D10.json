al": true}, {"i": 76, "pag": 1, "texto": "JEFE SUBDIVISION JURIDICA", "conf": null, "fuente": "vlm", "parrafo": 17, "marginal": false}, {"i": 77, "pag": 1, "texto": "DIVISION INFRAESTRUCTURA Y REGULACION", "conf": null, "fuente": "vlm", "parrafo": 17, "marginal": false}, {"i": 78, "pag": 2, "texto": "– La Resolución DGOP Nº 194 de fecha 31 de agosto de 2011, que aprueba la Circular Aclaratoria Nº 4 de las", "conf": null, "fuente": "vlm", "parrafo": 18, "marginal": false}, {"i": 79, "pag": 2, "texto": "Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio", "conf": null, "fuente": "vlm", "parrafo": 18, "marginal": false}, {"i": 80, "pag": 2, "texto": "Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 18, "marginal": false}, {"i": 81, "pag": 2, "texto": "– La Resolución DGOP Nº 231 de fecha 26 de octubre de 2011, que aprueba la Circular Aclaratoria Nº 5 de las", "conf": null, "fuente": "vlm", "parrafo": 19, "marginal": false}, {"i": 82, "pag": 2, "texto": "Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio", "conf": null, "fuente": "vlm", "parrafo": 19, "marginal": false}, {"i": 83, "pag": 2, "texto": "Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 19, "marginal": false}, {"i": 84, "pag": 2, "texto": "– La Resolución DGOP Nº 87 de fecha 11 de mayo de 2012, que aprueba la Circular Aclaratoria Nº 6 de las", "conf": null, "fuente": "vlm", "parrafo": 20, "marginal": false}, {"i": 85, "pag": 2, "texto": "Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio", "conf": null, "fuente": "vlm", "parrafo": 20, "marginal": false}, {"i": 86, "pag": 2, "texto": "Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 20, "marginal": false}, {"i": 87, "pag": 2, "texto": "– La Resolución DGOP Nº 228 de fecha 19 de noviembre de 2012, que aprueba la Circular Aclaratoria Nº 7 de", "conf": null, "fuente": "vlm", "parrafo": 21, "marginal": false}, {"i": 88, "pag": 2, "texto": "las Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo", "conf": null, "fuente": "vlm", "parrafo": 21, "marginal": false}, {"i": 89, "pag": 2, "texto": "Vespucio Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 21, "marginal": false}, {"i": 90, "pag": 2, "texto": "– La Resolución DGOP Nº 12 de fecha 30 de enero de 2013, que aprueba la Circular Aclaratoria Nº 8 de las", "conf": null, "fuente": "vlm", "parrafo": 22, "marginal": false}, {"i": 91, "pag": 2, "texto": "Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio", "conf": null, "fuente": "vlm", "parrafo": 22, "marginal": false}, {"i": 92, "pag": 2, "texto": "Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 22, "marginal": false}, {"i": 93, "pag": 2, "texto": "– La Resolución Nº 1.600 de fecha 30 de octubre de 2008 de la Contraloría General de la República, que Fija", "conf": null, "fuente": "vlm", "parrafo": 23, "marginal": false}, {"i": 94, "pag": 2, "texto": "Normas sobre Exención del Trámite de Toma de Razón.", "conf": null, "fuente": "vlm", "parrafo": 23, "marginal": false}, {"i": 95, "pag": 2, "texto": "CONSIDERANDO:", "conf": null, "fuente": "vlm", "parrafo": 24, "marginal": false}, {"i": 96, "pag": 2, "texto": "– Que, de conformidad con lo establecido en el artículo 1º de las Bases de Precalificación del Registro Especial", "conf": null, "fuente": "vlm", "parrafo": 25, "marginal": false}, {"i": 97, "pag": 2, "texto": "Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”, dada la necesidad de mejorar el nivel", "conf": null, "fuente": "vlm", "parrafo": 25, "marginal": false}, {"i": 98, "pag": 2, "texto": "de servicio de la Circunvalación Américo Vespucio en su tramo no concesionado en el sector oriente de", "conf": null, "fuente": "vlm", "parrafo": 25, "marginal": false}, {"i": 99, "pag": 2, "texto": "Santiago, el MOP convocó a los interesados a postular en la precalificación de licitantes para los proyectos de", "conf": null, "fuente": "vlm", "parrafo": 25, "marginal": false}, {"i": 100, "pag": 2, "texto": "concesiones de Américo Vespucio Oriente;", "conf": null, "fuente": "vlm", "parrafo": 25, "marginal": false}, {"i": 101, "pag": 2, "texto": "– Que, en este contexto, dentro de la cartera de proyectos que lleva a adelante este Ministerio, se encuentra el", "conf": null, "fuente": "vlm", "parrafo": 26, "marginal": false}, {"i": 102, "pag": 2, "texto": "proyecto denominado “Concesión Américo Vespucio Oriente. Tramo Príncipe de Gales - Los Presidentes” el", "conf": null, "fuente": "vlm", "parrafo": 26, "marginal": false}, {"i": 103, "pag": 2, "texto": "cual reviste especial interés público por cuanto permitirá dotar al total de la circunvalación Américo Vespucio,", "conf": null, "fuente": "vlm", "parrafo": 26, "marginal": false}, {"i": 104, "pag": 2, "texto": "parte de la vialidad estructurante de la ciudad de Santiago, de un estándar de vía urbana concesionada;", "conf": null, "fuente": "vlm", "parrafo": 26, "marginal": false}, {"i": 105, "pag": 2, "texto": "– Que el periodo para la recepción de solicitudes de inscripción en el Registro Especial Internacional “Proyectos", "conf": null, "fuente": "vlm", "parrafo": 27, "marginal": false}, {"i": 106, "pag": 2, "texto": "de Concesiones de Américo Vespucio Oriente” se encuentra actualmente cerrado, habiendo concluido el", "conf": null, "fuente": "vlm", "parrafo": 27, "marginal": false}, {"i": 107, "pag": 2, "texto": "proceso de licitación del proyecto denominado “Américo Vespucio Oriente. Tramo Av. El Salto – Príncipe de", "conf": null, "fuente": "vlm", "parrafo": 27, "marginal": false}, {"i": 108, "pag": 2, "texto": "Gales”, por lo que es altamente necesario reimpulsar el proceso de precalificación, considerando", "conf": null, "fuente": "vlm", "parrafo": 27, "marginal": false}, {"i": 109, "pag": 2, "texto": "particularmente la próxima licitación del proyecto “Concesión Américo Vespucio Oriente Tramo Príncipe de", "conf": null, "fuente": "vlm", "parrafo": 27, "marginal": false}, {"i": 110, "pag": 2, "texto": "Gales – Los Presidentes”, con el objeto de permitir que nuevos interesados ingresen al Registro;", "conf": null, "fuente": "vlm", "parrafo": 27, "marginal": false}, {"i": 111, "pag": 2, "texto": "– Que, a efectos de lo señalado y de acuerdo a lo establecido en el inciso segundo del artículo 3.2 “Fechas", "conf": null, "fuente": "vlm", "parrafo": 28, "marginal": false}, {"i": 112, "pag": 2, "texto": "Máximas de Recepción de Solicitudes y Cierre del Registro” de las Bases de Precalificación del Registro", "conf": null, "fuente": "vlm", "parrafo": 28, "marginal": false}, {"i": 113, "pag": 2, "texto": "Especial Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”, el Ministerio de Obras", "conf": null, "fuente": "vlm", "parrafo": 28, "marginal": false}, {"i": 114, "pag": 2, "texto": "Públicas se reserva el derecho de ampliar o de convocar a un nuevo periodo de recepción de solicitudes de", "conf": null, "fuente": "vlm", "parrafo": 28, "marginal": false}, {"i": 115, "pag": 2, "texto": "inscripción en el REI, por razones fundadas;", "conf": null, "fuente": "vlm", "parrafo": 28, "marginal": false}, {"i": 116, "pag": 2, "texto": "– Que, de acuerdo a lo establecido en el artículo 2.6.2 “Circulares Aclaratorias” de las Bases de Precalificación", "conf": null, "fuente": "vlm", "parrafo": 29, "marginal": false}, {"i": 117, "pag": 2, "texto": "del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”, el Director", "conf": null, "fuente": "vlm", "parrafo": 29, "marginal": false}, {"i": 118, "pag": 2, "texto": "General de Obras Públicas podrá emitir Circulares Aclaratorias aclarando, rectificando, enmendando o", "conf": null, "fuente": "vlm", "parrafo": 29, "marginal": false}, {"i": 119, "pag": 2, "texto": "adicionando los contenidos de las Bases de Precalificación;", "conf": null, "fuente": "vlm", "parrafo": 29, "marginal": false}, {"i": 120, "pag": 2, "texto": "– Que, por lo tanto y con el objeto de materializar lo señalado, se requiere convocar un nuevo período para la", "conf": null, "fuente": "vlm", "parrafo": 30, "marginal": false}, {"i": 121, "pag": 2, "texto": "recepción de solicitudes de inscripción en el Registro Especial Internacional “Proyectos de Concesiones de", "conf": null, "fuente": "vlm", "parrafo": 30, "marginal": false}, {"i": 122, "pag": 2, "texto": "Américo Vespucio Oriente”; y,", "conf": null, "fuente": "vlm", "parrafo": 30, "marginal": false}, {"i": 123, "pag": 3, "texto": "– Que, para efectos de lo anterior, debe aprobarse la Circular Aclaratoria N° 9 mediante la cual se introduce la", "conf": null, "fuente": "vlm", "parrafo": 31, "marginal": false}, {"i": 124, "pag": 3, "texto": "correspondiente rectificación a las Bases de Precalificación del Registro Especial Internacional “Proyectos de", "conf": null, "fuente": "vlm", "parrafo": 31, "marginal": false}, {"i": 125, "pag": 3, "texto": "Concesiones de Américo Vespucio Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 31, "marginal": true}, {"i": 126, "pag": 3, "texto": "RESUELVO:", "conf": null, "fuente": "vlm", "parrafo": 32, "marginal": false}, {"i": 127, "pag": 3, "texto": "D.G.O.P. N° 14 /", "conf": null, "fuente": "vlm", "parrafo": 32, "marginal": false}, {"i": 128, "pag": 3, "texto": "TRAMITADA", "conf": null, "fuente": "vlm", "parrafo": 32, "marginal": false}, {"i": 129, "pag": 3, "texto": "29 ENE 2016", "conf": null, "fuente": "vlm", "parrafo": 32, "marginal": false}, {"i": 130, "pag": 3, "texto": "OFICINA DE PARTES", "conf": null, "fuente": "vlm", "parrafo": 32, "marginal": false}, {"i": 131, "pag": 3, "texto": "DIREC. GRAL. DE OBRAS PUBLICAS", "conf": null, "fuente": "vlm", "parrafo": 32, "marginal": false}, {"i": 132, "pag": 3, "texto": "I. APRUÉBASE la Circular Aclaratoria N° 9 de las Bases de Precalificación del Registro Especial", "conf": null, "fuente": "vlm", "parrafo": 33, "marginal": false}, {"i": 133, "pag": 3, "texto": "Internacional “Proyectos de Concesiones de Américo Vespucio Oriente” cuyo texto es el siguiente:", "conf": null, "fuente": "vlm", "parrafo": 33, "marginal": false}, {"i": 134, "pag": 3, "texto": "1. En el artículo 3.2 “Fecha Máxima de Recepción de Solicitudes y Cierre del Registro”, previamente", "conf": null, "fuente": "vlm", "parrafo": 34, "marginal": false}, {"i": 135, "pag": 3, "texto": "modificado por las Circulares Aclaratorias N° 1, N° 2, N° 3, N° 5, N° 6, N°7 y N°8 se reemplaza el", "conf": null, "fuente": "vlm", "parrafo": 34, "marginal": false}, {"i": 136, "pag": 3, "texto": "primer párrafo por el siguiente:", "conf": null, "fuente": "vlm", "parrafo": 34, "marginal": false}, {"i": 137, "pag": 3, "texto": "“El Ministerio de Obras Públicas recibirá solicitudes de inscripción en el Registro Especial", "conf": null, "fuente": "vlm", "parrafo": 35, "marginal": false}, {"i": 138, "pag": 3, "texto": "Internacional de aquellos interesados que deseen postular, desde la fecha de apertura indicada en el", "conf": null, "fuente": "vlm", "parrafo": 35, "marginal": false}, {"i": 139, "pag": 3, "texto": "artículo 3.1 de las presentes Bases de Precalificación, hasta el día 30 de junio de 2016”.", "conf": null, "fuente": "vlm", "parrafo": 35, "marginal": false}, {"i": 140, "pag": 3, "texto": "II. COMUNÍQUESE a los Interesados y/o Grupos Interesados, a la Oficina de Partes de la DGOP y a los", "conf": null, "fuente": "vlm", "parrafo": 36, "marginal": false}, {"i": 141, "pag": 3, "texto": "demás Servicios que correspondan.", "conf": null, "fuente": "vlm", "parrafo": 36, "marginal": false}, {"i": 142, "pag": 3, "texto": "ANÓTESE, TÓMESE RAZÓN Y COMUNÍQUESE", "conf": null, "fuente": "vlm", "parrafo": 37, "marginal": false}, {"i": 143, "pag": 3, "texto": "JUAN MANUEL SÁNCHEZ MEDIOLI", "conf": null, "fuente": "vlm", "parrafo": 38, "marginal": false}, {"i": 144, "pag": 3, "texto": "D