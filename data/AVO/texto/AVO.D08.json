, "parrafo": 8, "marginal": false}, {"i": 45, "pag": 1, "texto": "Concesiones de Américo Vespucio Oriente\".", "conf": null, "fuente": "vlm", "parrafo": 8, "marginal": false}, {"i": 46, "pag": 1, "texto": "– La Resolución DGOP Nº 348 de fecha 14 de diciembre de", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 47, "pag": 1, "texto": "2007, que aprueba la Circular Aclaratoria Nº 1 de las", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 48, "pag": 1, "texto": "Bases de Precalificación del Registro Especial", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 49, "pag": 1, "texto": "Internacional \"Proyectos de Concesiones de Américo", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 50, "pag": 1, "texto": "Vespucio Oriente\".", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 51, "pag": 1, "texto": "REFRENDACION", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 52, "pag": 1, "texto": "REF. POR $ __________", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 53, "pag": 1, "texto": "IMPUTAC. __________", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 54, "pag": 1, "texto": "ANOT. POR $ __________", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 55, "pag": 1, "texto": "IMPUTAC. __________", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 56, "pag": 1, "texto": "____________________", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": true}, {"i": 57, "pag": 1, "texto": "DEDUC DTO. __________", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 58, "pag": 1, "texto": "|  |  |  |", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 59, "pag": 1, "texto": "Nº Proceso 6 262846", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 60, "pag": 1, "texto": "TOMO RAZÓN", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 61, "pag": 1, "texto": "POR ORDEN DEL CONTRALOR", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 62, "pag": 1, "texto": "GENERAL DE LA REPÚBLICA", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 63, "pag": 1, "texto": "27 NOV. 2012", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 64, "pag": 1, "texto": "JEFE DIVISIÓN", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 65, "pag": 1, "texto": "INFRAESTRUCTURA Y REGULACIÓN", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 66, "pag": 2, "texto": "- La Resolución DGOP Nº 111 de fecha 8 de julio de 2010, que aprueba la Circular Aclaratoria Nº 2 de las Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 10, "marginal": false}, {"i": 67, "pag": 2, "texto": "- La Resolución DGOP Nº 75 de fecha 26 de abril de 2011, que aprueba la Circular Aclaratoria Nº 3 de las Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 11, "marginal": false}, {"i": 68, "pag": 2, "texto": "- La Resolución DGOP Nº 194 de fecha 31 de agosto de 2011, que aprueba la Circular Aclaratoria Nº 4 de las Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 12, "marginal": false}, {"i": 69, "pag": 2, "texto": "- La Resolución DGOP Nº 231 de fecha 26 de octubre de 2011, que aprueba la Circular Aclaratoria Nº 5 de las Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 13, "marginal": false}, {"i": 70, "pag": 2, "texto": "- La Resolución DGOP Nº 87 de fecha 11 de mayo de 2012, que aprueba la Circular Aclaratoria Nº 6 de las Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”.", "conf": null, "fuente": "vlm", "parrafo": 14, "marginal": false}, {"i": 71, "pag": 2, "texto": "- La Resolución Nº 1.600 de fecha 30 de octubre de 2008 de la Contraloría General de la República, que Fija Normas sobre Exención del Trámite de Toma de Razón.", "conf": null, "fuente": "vlm", "parrafo": 15, "marginal": false}, {"i": 72, "pag": 2, "texto": "CONSIDERANDO:", "conf": null, "fuente": "vlm", "parrafo": 16, "marginal": false}, {"i": 73, "pag": 2, "texto": "- Que, de acuerdo a lo establecido en el artículo 2.6.2 “Circulares Aclaratorias” de las Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”, el Director General de Obras Públicas podrá emitir Circulares Aclaratorias aclarando, rectificando, enmendando o adicionando los contenidos de las Bases de Precalificación.", "conf": null, "fuente": "vlm", "parrafo": 17, "marginal": false}, {"i": 74, "pag": 2, "texto": "- Que, de acuerdo a los establecido en el inciso segundo del artículo 3.2 “Fechas Máximas de Recepción de Solicitudes y Cierre del Registro” de las Bases de Precalificación del Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”, el Ministerio de Obras Públicas se reserva el derecho de ampliar o de convocar a un nuevo periodo de recepción de solicitudes de inscripción en el REI, por razones fundadas.", "conf": null, "fuente": "vlm", "parrafo": 18, "marginal": false}, {"i": 75, "pag": 2, "texto": "- Que, por su parte, el proyecto “Américo Vespucio Oriente” reviste especial interés público por cuanto permite dotar al total de la circunvalación Américo Vespucio, parte de la vialidad estructurante de la ciudad de Santiago, de un estándar de vía urbana concesionada.", "conf": null, "fuente": "vlm", "parrafo": 19, "marginal": false}, {"i": 76, "pag": 2, "texto": "- Que, el periodo para la recepción de solicitudes de inscripción en el Registro Especial Internacional “Proyectos de Concesiones de Américo Vespucio Oriente”, se encuentra actualmente cerrado, y que la Ministra de Obras Públicas considera altamente necesario reimpulsar el proceso de precalificación a fin de contar con un mayor número de precalificados para participar en la licitación del proyecto “Américo Vespucio Oriente”, de manera de asegurar un grado tal de competencia entre los licitantes que permita al Estado obtener un óptimo beneficio fiscal.", "conf": null, "fuente": "vlm", "parrafo": 20, "marginal": false}, {"i": 77, "pag": 2, "texto": "- Que, por lo tanto y con el objeto de materializar lo señalado, se requiere convocar un nuevo período para la recepción de solicitudes de inscripción en Registro Especial Internacional “Proyectos de", "conf": null, "fuente": "vlm", "parrafo": 21, "marginal": false}, {"i": 78, "pag": 3, "texto": "Concesiones de Américo Vespucio Oriente\", dadas además las facultades legales, reglamentarias y", "conf": null, "fuente": "vlm", "parrafo": 22, "marginal": false}, {"i": 79, "pag": 3, "texto": "administrativas.", "conf": null, "fuente": "vlm", "parrafo": 22, "marginal": false}, {"i": 80, "pag": 3, "texto": "- Que, para efectos de lo anterior, debe aprobarse la Circular Aclaratoria N° 7 mediante la cual se", "conf": null, "fuente": "vlm", "parrafo": 23, "marginal": false}, {"i": 81, "pag": 3, "texto": "introduce la correspondiente rectificación a las Bases de Precalificación del Registro Especial", "conf": null, "fuente": "vlm", "parrafo": 23, "marginal": false}, {"i": 82, "pag": 3, "texto": "Internacional \"Proyectos de Concesiones de Américo Vespucio Oriente\".", "conf": null, "fuente": "vlm", "parrafo": 23, "marginal": false}, {"i": 83, "pag": 3, "texto": "RESUELVO:", "conf": null, "fuente": "vlm", "parrafo": 24, "marginal": false}, {"i": 84, "pag": 3, "texto": "228", "conf": null, "fuente": "vlm", "parrafo": 24, "marginal": false}, {"i": 85, "pag": 3, "texto": "DGOP N° _________________ /", "conf": null, "fuente": "vlm", "parrafo": 24, "marginal": false}, {"i": 86, "pag": 3, "texto": "TRAMITADA", "conf": null, "fuente": "vlm", "parrafo": 24, "marginal": false}, {"i": 87, "pag": 3, "texto": "29 NOV 2012", "conf": null, "fuente": "vlm", "parrafo": 24, "marginal": false}, {"i": 88, "pag": 3, "texto": "OFICINA DE PARTES", "conf": null, "fuente": "vlm", "parrafo": 24, "marginal": false}, {"i": 89, "pag": 3, "texto": "DIREC. GRAL. DE OBRAS PUBLICAS", "conf": null, "fuente": "vlm", "parrafo": 24, "marginal": false}, {"i": 90, "pag": 3, "texto": "I. APRUÉBASE la Circular Aclaratoria N° 7 de las Bases de Precalificación del Registro Especial", "conf": null, "fuente": "vlm", "parrafo": 25, "marginal": false}, {"i": 91, "pag": 3, "texto": "Internacional \"Proyectos de Concesiones de Américo Vespucio Oriente\" cuyo texto es el", "conf": null, "fuente": "vlm", "parrafo": 25, "marginal": false}, {"i": 92, "pag": 3, "texto": "siguiente:", "conf": null, "fuente": "vlm", "parrafo": 25, "marginal": false}, {"i": 93, "pag": 3, "texto": "En el artículo 3.2 \"Fecha Máxima de Recepción de Solicitudes y Cierre del Registro\",", "conf": null, "fuente": "vlm", "parrafo": 26, "marginal": false}, {"i": 94, "pag": 3, "texto": "previamente modificado por las Circulares Aclaratorias N° 1, N° 2, N° 3, N° 5 y N° 6, se", "conf": null, "fuente": "vlm", "parrafo": 26, "marginal": false}, {"i": 95, "pag": 3, "texto": "reemplaza el primer párrafo por el siguiente:", "conf": null, "fuente": "vlm", "parrafo": 26, "marginal": false}, {"i": 96, "pag": 3, "texto": "\"El Ministerio de Obras Públicas recibirá solicitudes de inscripción en el Registro Especial", "conf": null, "fuente": "vlm", "parrafo": 27, "marginal": false}, {"i": 97, "pag": 3, "texto": "Internacional de aquellos interesados que deseen postular, desde la fecha de apertura indicada", "conf": null, "fuente": "vlm", "parrafo": 27, "marginal": false}