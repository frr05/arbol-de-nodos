{"documento": "AVO.D13", "archivo": "1_licitacion/AVOII-Circular-aclaratoria-N_2.pdf", "lineas": [{"i": 0, "pag": 1, "texto": "171", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": true}, {"i": 1, "pag": 1, "texto": "REPÚBLICA DE CHILE", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 2, "pag": 1, "texto": "MINISTERIO DE OBRAS PÚBLICAS", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 3, "pag": 1, "texto": "DIRECCIÓN GENERAL DE OBRAS", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 4, "pag": 1, "texto": "PÚBLICAS", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 5, "pag": 1, "texto": "Aprueba Circular Aclaratoria N°2 de las Bases de", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 6, "pag": 1, "texto": "Licitación de la obra pública fiscal denominada", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 7, "pag": 1, "texto": "“Concesión Américo Vespucio Oriente, Tramo Av.", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 8, "pag": 1, "texto": "Príncipe de Gales – Los Presidentes” a ejecutar por el", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 9, "pag": 1, "texto": "sistema de concesiones.", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 10, "pag": 1, "texto": "MINISTERIO DE HACIENDA", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 11, "pag": 1, "texto": "OFICINA DE PARTES", "conf": null, "fuente": "vlm", "parrafo": 0, "marginal": false}, {"i": 12, "pag": 1, "texto": "RECIBIDO", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 13, "pag": 1, "texto": "SANTIAGO, 28 OCT 2016", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 14, "pag": 1, "texto": "VISTOS:", "conf": null, "fuente": "vlm", "parrafo": 1, "marginal": false}, {"i": 15, "pag": 1, "texto": "CONTRALORIA GENERAL", "conf": null, "