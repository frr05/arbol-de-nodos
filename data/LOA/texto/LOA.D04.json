 61, "pag": 1, "texto": "Bases de Licitación de la obra pública fiscal", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 62, "pag": 1, "texto": "denominada \"Concesión Vial Rutas del Loa\" a", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 63, "pag": 1, "texto": "ejecutar por el sistema de concesiones y su", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 64, "pag": 1, "texto": "Circular Aclaratoria Nº 1.", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 65, "pag": 1, "texto": "TOMO RAZON", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 66, "pag": 1, "texto": "POR ORDEN DEL CONTRALOR", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 67, "pag": 1, "texto": "GENERAL DE LA REPUBLICA", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 68, "pag": 1, "texto": "- 7 SET. 2012", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 69, "pag": 1, "texto": "JEFE DIVISIÓN", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 70, "pag": 1, "texto": "INFRAESTRUCTURA Y REGULACIÓN", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 71, "pag": 1, "texto": "GABINETE DGOP", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 72, "pag": 1, "texto": "04 SEP 2012", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": false}, {"i": 73, "pag": 1, "texto": "Nº Proceso 6058506", "conf": null, "fuente": "vlm", "parrafo": 6, "marginal": true}, {"i": 74, "pag": 2, "texto": "– La Resolución DGOP Nº 135 de 13 de julio de 2012, que aprueba la Circular Aclaratoria Nº 2 de las", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 75, "pag": 2, "texto": "Bases de Licitación de la obra pública fiscal denominada “Concesión Vial Rutas del Loa” a ejecutar por", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 76, "pag": 2, "texto": "el sistema de concesiones.", "conf": null, "fuente": "vlm", "parrafo": 7, "marginal": false}, {"i": 77, "pag": 2, "texto": "– La Resolución Nº 1.600 de 2008, de la Contraloría General de la República, que Fija Normas sobre", "conf": null, "fuente": "vlm", "parrafo": 8, "marginal": false}, {"i": 78, "pag": 2, "texto": "Exención del Trámite de Toma de Razón.", "conf": null, "fuente": "vlm", "parrafo": 8, "marginal": false}, {"i": 79, "pag": 2, "texto": "CONSIDERANDO:", "conf": null, "fuente": "vlm", "parrafo": 9, "marginal": false}, {"i": 80, "pag": 2, "texto": "– Que, de acuerdo a lo dispuesto en los artículos 18 del D.S. MOP Nº 956 de 1997, Reglamento de la Ley", "conf": null, "fuente": "vlm", "parrafo": 10, "marginal": false}, {"i": 81, "pag": 2, "texto": "de Concesiones de Obras Públicas, y 1.4.5 de las Bases de Licitación, las aclaraciones, rectificaciones,", "conf": null, "fuente": "vlm", "parrafo": 10, "marginal": false}, {"i": 82, "pag": 2, "texto": "enmiendas o adiciones a las Bases de Licitación, así como las respuestas a las Consultas formuladas al", "conf": null, "fuente": "vlm", "parrafo": 10, "marginal": false}, {"i": 83, "pag": 2, "texto": "DGOP sobre éstas, serán incluidas en comunicaciones denominadas Circulares Aclaratorias, dirigidas a", "conf": null, "fuente": "vlm", "parrafo": 10, "marginal": false}, {"i": 84, "pag": 2, "texto": "todos los licitantes.", "conf": null, "fuente": "vlm", "parrafo": 10, "marginal": false}, {"i": 85, "pag": 2, "texto": "– Que se ha estimado necesario efectuar, mediante Circular Aclaratoria Nº 3, rectificaciones a las Bases de", "conf": null, "fuente": "vlm", "parrafo": 11, "marginal": false}, {"i": 86, "pag": 2, "texto": "Licitación del proyecto “Concesión Vial Rutas del Loa”, aprobadas por Resolución DGOP Nº 116 de 13", "conf": null, "fuente": "vlm", "parrafo": 11, "marginal": false}, {"i": 87, "pag": 2, "texto": "de junio de 2012.", "conf": null, "fuente": "vlm", "parrafo": 11, "marginal": false}, {"i": 88, "pag": 2, "texto": "– Que la Circular Aclaratoria Nº 3 de las Bases de Licitación de la obra pública fiscal denominada", "conf": null, "fuente": "vlm", "parrafo": 12, "marginal": false}, {"i": 89, "pag": 2, "texto": "“Concesión Vial Rutas del Loa”, que se aprueba por la presente Resolución, implica modificaciones a las", "conf": null, "fuente": "vlm", "parrafo": 12, "marginal": false}, {"i": 90, "pag": 2, "texto": "Bases de Licitación, por lo que se encuentra visada por el Ministerio de Hacienda, de acuerdo a lo", "conf": null, "fuente": "vlm", "parrafo": 12, "marginal": false}, {"i": 91, "pag": 2, "texto": "exigido en el Nº 3 del artículo 18º del D.S. MOP Nº956 de 1997, Reglamento de la Ley de Concesiones", "conf": null, "fuente": "vlm", "parrafo": 12, "marginal": false}, {"i": 92, "pag": 2, "texto": "de Obras Públicas.", "conf": null, "fuente": "vlm", "parrafo": 12, "marginal": false}, {"i": 93, "pag": 2, "texto": "RESUELVO: 180", "conf": null, "fuente": "vlm", "parrafo": 13, "marginal": false}, {"i": 94, "pag": 2, "texto": "D.G.O.P. Nº __________/", "conf": null, "fuente": "vlm", "parrafo": 13, "marginal": false}, {"i": 95, "pag": 2, "texto": "TRAMITADA", "conf": null, "fuente": "vlm", "parrafo": 13, "marginal": false}, {"i": 96, "pag": 2, "texto": "11 SEP 2012", "conf": null, "fuente": "vlm", "parrafo": 13, "marginal": false}, {"i": 97, "pag": 2, "texto": "OFICINA DE PARTES", "conf": null, "fuente": "vlm", "parrafo": 13, "marginal": false}, {"i": 98, "pag": 2, "texto": "DIREC. GRAL. DE OBRAS PUBLICAS", "conf": null, "fuente": "vlm", "parrafo": 13, "marginal": false}, {"i": 99, "pag": 2, "texto": "I. APRUÉBASE la Circular Aclaratoria Nº 3 de las Bases de Licitación de la obra pública fiscal", "conf": null, "fuente": "vlm", "parrafo": 14, "marginal": false}, {"i": 100, "pag": 2, "texto": "denominada “Concesión Vial Rutas del Loa”, cuyo texto es el siguiente:", "conf": null, "fuente": "vlm", "parrafo": 14, "marginal": false}, {"i": 101, "pag": 2, "texto": "1. En 1.6.1 