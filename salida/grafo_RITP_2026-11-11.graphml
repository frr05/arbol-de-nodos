  <data key="d2">inciso 9</data>
  <data key="d3">BL:2.1</data>
  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">295.4</data>
  <data key="d7">-80.0</data>
  <data key="d8">6. Construcción de defensas fluviales en Río Andalién, sector Puente Las Ballenas.</data>
  <data key="d9">10</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
