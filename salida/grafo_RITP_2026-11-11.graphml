  <data key="d1">1.14.6.1.1 ¶2</data>
  <data key="d2">inciso 2</data>
  <data key="d3">BL:1.14</data>
  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">-693.6999999999999</data>
  <data key="d7">30.700000000000003</data>
  <data key="d8">IMGt : Ingreso Mínimo Garantizado por el Estado en UF en el año calendario "t" de explotación de la
concesión según la Tabla Nº 3.</data>
  <data key="d9">6</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:1.14.6.1.1-i3">
