  <data key="d5">2001-08-01</data>
  <data key="d6">-426.4</data>
  <data key="d7">892.5</data>
  <data key="d8">•  Medidas de mantención de las distintas instalaciones.</data>
  <data key="d9">12</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
