  <data key="d5">2001-08-01</data>
  <data key="d6">154.6</data>
  <data key="d7">792.1</data>
  <data key="d8">1. Riesgos de accidentes en la vía.
2. Riesgos de incendios.
3. Riesgos de corte de puentes
4. Riesgos de eventos naturales.</data>
  <data key="d9">12</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
