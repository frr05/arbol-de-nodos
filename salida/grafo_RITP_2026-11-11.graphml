  <data key="d2">inciso 3</data>
  <data key="d3">BL:1.4</data>
  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">71.4</data>
  <data key="d7">-226.89999999999998</data>
  <data key="d8">c) Todos los costos adicionales (obras, equipos, expropiaciones, etc.) que se generen a raíz del Anteproyecto Alternativo, serán de cargo del Concesionario.</data>
  <data key="d9">3</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
