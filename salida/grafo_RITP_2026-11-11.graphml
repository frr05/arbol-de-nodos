  <data key="d6">847.9</data>
  <data key="d7">-462.4</data>
  <data key="d8">• Ahuellamiento Máximo: 15 mm</data>
  <data key="d9">9</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
