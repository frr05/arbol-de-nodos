  <data key="d5">2007-04-30</data>
  <data key="d6">482.5</data>
  <data key="d7">502.09999999999997</data>
  <data key="d8">1.1 | GEOMORFOLOGIA |
| D 176 MANTENCION DE TALUDES ETAPA DE EXPLOTACION | 26.927,16
| D 196 PLAN DE SEGUIMIENTO AMBIENTAL DE TALUDES | 1.292,46</data>
  <data key="d9">7</data>
  <data key="d10">RITP.D11.A1</data>
  <data key="d11"></data>
</node>
