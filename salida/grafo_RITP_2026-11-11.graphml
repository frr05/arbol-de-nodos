  <data key="d0">inciso</data>
  <data key="d1">2.1 ¶10</data>
  <data key="d2">inciso 10</data>
  <data key="d3">BL:2.1</data>
  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">291.7</data>
  <data key="d7">-75.0</data>
  <data key="d8">7. Construcción de un paso sobre la línea Férrea Concepción – Penco – Lirquén (Ramal Rucapequén), de aproximadamente 39 m de longitud (“Paso las Gaviotas”), ubicado en el km 2,855.</data>
  <data key="d9">10</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
