  <data key="d5">2001-08-01</data>
  <data key="d6">-390.40000000000003</data>
  <data key="d7">642.5999999999999</data>
  <data key="d8">Tabla Nº 20: Lista de Contingencias y Acciones Mínimas a seguir durante la Etapa de Construcción.</data>
  <data key="d9">12</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
