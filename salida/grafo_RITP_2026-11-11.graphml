<node id="BL:1.7.7.1">
  <data key="d0">articulo</data>
  <data key="d1">1.7.7.1</data>
  <data key="d2">1.7.7.1 Cumplimiento del Ordenamiento Jurídico</data>
  <data key="d3">BL:1.7</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">-460.2</data>
  <data key="d7">-650.8000000000001</data>
  <data key="d8"></data>
