  <data key="d5"></data>
  <data key="d6">-129.3</data>
  <data key="d7">165.3</data>
  <data key="d8"></data>
  <data key="d9">8</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:1.8.13-i1">
  <data key="d0">inciso</data>
  <data key="d1">1.8.13 ¶1</data>
  <data key="d2">inciso 1</data>
  <data key="d3">BL:1.8</data>
  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">-128.20000000000002</data>
  <data key="d7">168.1</data>
  <data key="d8">La Sociedad Concesionaria se regirá por las normas del derecho privado y, en general, podrá realizar
cualquier operación lícita, sin necesidad de la autorización previa del MOP, siempre que se dé cumplimiento
a lo establecido en los incisos segundo y siguientes del artículo 21° del DS MOP N°900 de 1996.</data>
  <data key="d9">8</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
