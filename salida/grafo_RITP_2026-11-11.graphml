<node id="BL:2.6">
  <data key="d0">capitulo</data>
  <data key="d1">2.6</data>
  <data key="d2">2.6 DE LA EXPLOTACION DE LA CONCESION</data>
  <data key="d3">BL:2.6</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">611.6</data>
  <data key="d7">-74.80000000000001</data>
  <data key="d8"></data>
