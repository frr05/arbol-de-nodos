  <data key="d5">2001-08-01</data>
  <data key="d6">-416.8</data>
  <data key="d7">892.5999999999999</data>
  <data key="d8">• Disponibilidad de maquinaria en el más breve plazo para el despeje de la ruta.</data>
  <data key="d9">12</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
