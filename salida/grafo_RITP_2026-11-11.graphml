  <data key="d5">2001-08-01</data>
  <data key="d6">-424.4</data>
  <data key="d7">892.9</data>
  <data key="d8">• Visita de un experto en mecánica de suelos para la determinación de eventuales caídas de materiales en
los sectores aledaños y proposición de medidas de prevención.</data>
  <data key="d9">12</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
