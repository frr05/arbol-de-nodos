  <data key="d2">inciso 2</data>
  <data key="d3">BL:1.13</data>
  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">-633.1</data>
  <data key="d7">-61.5</data>
  <data key="d8">Durante el período de intervención seguirán vigentes todos los derechos y obligaciones del Estado derivados del contrato de concesión.</data>
  <data key="d9">9</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
