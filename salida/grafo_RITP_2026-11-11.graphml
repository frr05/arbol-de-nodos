  <data key="d5">2001-08-01</data>
  <data key="d6">-9.2</data>
  <data key="d7">537.6999999999999</data>
  <data key="d8">Este Plan deberá ser mantenido en la forma de un manual, de fácil comprensión y disponible para todo el
personal.</data>
  <data key="d9">12</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
