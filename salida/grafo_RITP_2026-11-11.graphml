  <data key="d5">2001-08-01</data>
  <data key="d6">-416.4</data>
  <data key="d7">900.2</data>
  <data key="d8">•  Mantención de elementos de seguridad, señalización y demarcación en el área de la concesión.</data>
  <data key="d9">12</data>
  <data key="d10">RITP.D01.A1</data>
  <data key="d11"></data>
</node>
