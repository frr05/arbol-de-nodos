  <data key="d4">CN.D01.A1</data>
  <data key="d5">1999-07-01</data>
  <data key="d6">-554.6</data>
  <data key="d7">-505.2</data>
  <data key="d8">La no entrega de los planos y memorias explicativas en el plazo antes señalado dará lugar a la multa señalada en
1.7.13.</data>
  <data key="d9">2</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
<node id="CN.D34.F0010">
  <data key="d0">acto_posterior</data>
