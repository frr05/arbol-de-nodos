  <data key="d0">inciso</data>
  <data key="d1">1.14.3.4 ¶34</data>
  <data key="d2">inciso 34</data>
  <data key="d3">BL:1.14</data>
  <data key="d4">CN.D01.A1</data>
  <data key="d5">1999-07-01</data>
  <data key="d6">-694.3000000000001</data>
  <data key="d7">-224.8</data>
  <data key="d8">Cualquier acción desarrollada por el concesionario que sea contraria a lo establecido en este punto será
sancionada según lo indicado en 1.7.13.</data>
  <data key="d9">2</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
