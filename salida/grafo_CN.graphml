  <data key="d3">BL:2.5</data>
  <data key="d4">CN.D01.A1</data>
  <data key="d5">1999-07-01</data>
  <data key="d6">562.9</data>
  <data key="d7">-471.7</data>
  <data key="d8">El concesionario deberá implementar los requerimientos de los numerales 7.5.4, 7.5.5 y 7.5.6 sobre calidad del aire y sus exigencias, y numeral 7.4.6 sobre ruido y sus exigencias de la Resolución Ambiental.</data>
  <data key="d9">21</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
