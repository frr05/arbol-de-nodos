  <data key="d10">CN.D02.A3</data>
  <data key="d11"></data>
</node>
<node id="BL:1.14.2">
  <data key="d0">articulo</data>
  <data key="d1">1.14.2</data>
  <data key="d2">1.14.2 DESCRIPCION GENERAL DEL SISTEMA DE COBRO REQUERIDO</data>
  <data key="d3">BL:1.14</data>
