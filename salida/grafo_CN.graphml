  <data key="d2">inciso 6</data>
  <data key="d3">BL:2.4</data>
  <data key="d4">CN.D01.A1</data>
  <data key="d5">1999-07-01</data>
  <data key="d6">775.8000000000001</data>
  <data key="d7">527.1</data>
  <data key="d8">Lo anterior, sin perjuicio de lo establecido en la exigencia 17.7 de la Resolución Ambiental.</data>
  <data key="d9">2</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.4.10">
