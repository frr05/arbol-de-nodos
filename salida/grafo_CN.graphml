  <data key="d5">1999-07-01</data>
  <data key="d6">141.6</data>
  <data key="d7">-385.40000000000003</data>
  <data key="d8">Estos ejes están insertos en la red vial estructurante del Plan Regulador Metropolitano de Santiago.</data>
  <data key="d9">6</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
