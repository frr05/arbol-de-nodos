  <data key="d3">BL:2.5</data>
  <data key="d4">CN.D02.A5</data>
  <data key="d5">1999-11-02</data>
  <data key="d6">833.0</data>
  <data key="d7">46.199999999999996</data>
  <data key="d8">34. En 2.5.3.2 PAVIMENTOS modificado por la Circular Aclaratoria Nº 1, se reemplaza todo el texto por el siguiente:</data>
  <data key="d9">-1</data>
  <data key="d10">CN.D02.A5</data>
  <data key="d11"></data>
</node>
