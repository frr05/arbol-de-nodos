  <data key="d2">inciso 5</data>
  <data key="d3">BL:2.5</data>
  <data key="d4">CN.D01.A1</data>
  <data key="d5">1999-07-01</data>
  <data key="d6">491.8</data>
  <data key="d7">711.4</data>
  <data key="d8">Este plan de control de ruido deberá ser evaluado periódicamente, y contar con la aprobación del SESMA y cumplir con las exigencia 7 de la Resolución Ambiental.</data>
  <data key="d9">0</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
