  <data key="d5">1999-07-01</data>
  <data key="d6">667.1</data>
  <data key="d7">598.8</data>
  <data key="d8">Para estos efectos debe disponer de sistemas de vigilancia permanente y sistemas de patrullaje que permitan detectar y tomar las medidas de seguridad necesarias en forma oportuna.</data>
  <data key="d9">0</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
