  <data key="d5">1999-07-01</data>
  <data key="d6">-462.7</data>
  <data key="d7">89.1</data>
  <data key="d8">El concesionario presentará un plan de contingencia para los casos de desastres, tales como derrames de
sustancias peligrosas.</data>
  <data key="d9">19</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
