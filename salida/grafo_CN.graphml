  <data key="d5">1999-07-01</data>
  <data key="d6">-139.7</data>
  <data key="d7">-168.3</data>
  <data key="d8">La red deberá considerar que interconectará todas las redes locales de los puntos de cobro con la red del centro de
operaciones.</data>
  <data key="d9">79</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
