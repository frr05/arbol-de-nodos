<node id="BL:2.5.3.2-ins1">
  <data key="d0">instruccion</data>
  <data key="d1">instrucción 1 (Circular aclaratoria N°1 …</data>
  <data key="d2">instrucción 1 (Circular aclaratoria N°1 (1999-09-17))</data>
