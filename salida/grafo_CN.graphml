  <data key="d5">1999-11-02</data>
  <data key="d6">915.1</data>
  <data key="d7">-50.0</data>
  <data key="d8">“El Concesionario deberá desarrollar un Plan de Gestión para las emergencias, tal que le permita responder ante un accidente o contingencia que se produzca en cualquier lugar de la vía en un tiempo no superior a los 15 minutos, o al interior de los túneles en un tiempo no superior a los 10 minutos.</data>
  <data key="d9">10</data>
  <data key="d10">CN.D02.A5</data>
  <data key="d11"></data>
</node>
