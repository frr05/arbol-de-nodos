  <data key="d2">inciso 3</data>
  <data key="d3">BL:1.9</data>
  <data key="d4">CN.D02.A2</data>
  <data key="d5">1999-09-20</data>
  <data key="d6">420.9</data>
  <data key="d7">-378.7</data>
  <data key="d8">“El MOP no dará la autorización de puesta en servicio provisoria parcial o total de las obras si no se ha aprobado el reglamento de Servicios de la Obra y los Planes indicados en el párrafo anterior.”</data>
  <data key="d9">9</data>
  <data key="d10">CN.D02.A2</data>
  <data key="d11"></data>
</node>
