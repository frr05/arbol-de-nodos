  <data key="d3">BL:2.5</data>
  <data key="d4">CN.D01.A1</data>
  <data key="d5">1999-07-01</data>
  <data key="d6">916.2</data>
  <data key="d7">-51.8</data>
  <data key="d8">El concesionario deberá implementar un Plan de Contingencia, para la Etapa de Explotación, sobre la base de
los objetivos y componentes señalados en el Anexo Nº5 de la Resolución Ambiental. Se deberá coordinar con
los respectivos municipios, los detalles de esta acción, previo al inicio de la Etapa de Explotación.</data>
  <data key="d9">10</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.5.3.16-i2">
  <data key="d0">inciso</data>
  <data key="d1">2.5.3.16 ¶2</data>
  <data key="d2">inciso 2</data>
  <data key="d3">BL:2.5</data>
