  <data key="d5">1999-07-01</data>
  <data key="d6">-780.9000000000001</data>
  <data key="d7">-165.0</data>
  <data key="d8">Para tal efecto, las especificaciones técnicas deberán respetar lo siguiente:
a1) Paleta Luminosa de Publicidad.</data>
  <data key="d9">1</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
