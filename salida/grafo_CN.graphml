  <data key="d0">instruccion</data>
  <data key="d1">instrucción 1 (Circular aclaratoria N°5 …</data>
  <data key="d2">instrucción 1 (Circular aclaratoria N°5 (1999-11-02))</data>
  <data key="d3">BL:2.5</data>
  <data key="d4">CN.D02.A5</data>
  <data key="d5">1999-11-02</data>
  <data key="d6">-451.2</data>
  <data key="d7">-499.0</data>
  <data key="d8">35. Se adiciona un nuevo artículo 2.5.3.7.10 PLAN DE GESTIÓN DE TRÁNSITO</data>
  <data key="d9">-1</data>
  <data key="d10">CN.D02.A5</data>
