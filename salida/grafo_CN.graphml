  <data key="d4">CN.D01.A1</data>
  <data key="d5">1999-07-01</data>
  <data key="d6">605.4000000000001</data>
  <data key="d7">-555.6</data>
  <data key="d8">d) Cámaras de Video</data>
  <data key="d9">10</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
