  <data key="d5"></data>
  <data key="d6">111.4</data>
  <data key="d7">-127.1</data>
  <data key="d8"></data>
  <data key="d9">-1</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
