  <data key="d3">BL:1.13</data>
  <data key="d4">CN.D01.A1</data>
  <data key="d5">1999-07-01</data>
  <data key="d6">199.1</data>
  <data key="d7">-516.2</data>
  <data key="d8">Tabla 1-14
Fecha Fin Período de Marcha Blanca</data>
  <data key="d9">8</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:1.13.3-i3">
  <data key="d0">inciso</data>
  <data key="d1">1.13.3 ¶3</data>
  <data key="d2">inciso 3</data>
  <data key="d3">BL:1.13</data>
  <data key="d4">CN.D01.A1</data>
  <data key="d5">1999-07-01</data>
  <data key="d6">199.9</data>
  <data key="d7">-516.5</data>
  <data key="d8">Condición | Fecha de Puesta en Servicio Definitiva de la obra | Fecha fin período Transición
1 | Entre el 01 de Enero y el 28 ó 29 de Febrero del año t | 30 de Junio año t
2 | Entre el 01 de Marzo y el 30 de Agosto del año t | 31 de Diciembre año t
3 | Entre el 01 de Septiembre y el 31 de Diciembre del año t | 30 de Junio año t+1</data>
  <data key="d9">8</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
