  <data key="d5">1999-10-06</data>
  <data key="d6">720.7</data>
  <data key="d7">606.4000000000001</data>
  <data key="d8">22. En 2.3.1.4 "SEMAFORIZACION", se reemplaza el artículo por el siguiente:</data>
  <data key="d9">-1</data>
  <data key="d10">CN.D02.A3</data>
  <data key="d11"></data>
