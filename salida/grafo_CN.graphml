<node id="BL:2.5.4">
  <data key="d0">articulo</data>
  <data key="d1">2.5.4</data>
  <data key="d2">2.5.4 OPERACIÓN SISTEMA DE GESTIÓN DE TRÁFICO</data>
  <data key="d3">BL:2.5</data>
