  <data key="d0">instruccion</data>
  <data key="d1">instrucción 2 (Circular aclaratoria N°3 …</data>
  <data key="d2">instrucción 2 (Circular aclaratoria N°3 (1999-10-06))</data>
  <data key="d3">BL:1.7</data>
