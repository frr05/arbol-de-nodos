  <data key="d7">-92.2</data>
  <data key="d8">Para la determinación de los valores de las obras a sustituir se utilizarán los precios unitarios oficiales del anexo
Nº9.</data>
  <data key="d9">11</data>
  <data key="d10">CN.D01.A1</data>
  <data key="d11"></data>
</node>
