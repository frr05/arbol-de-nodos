  <data key="d4">CN.D02.A5</data>
  <data key="d5">1999-11-02</data>
  <data key="d6">832.5</data>
  <data key="d7">47.1</data>
  <data key="d8">• Ahuellamiento Máximo: 15 mm.</data>
  <data key="d9">7</data>
  <data key="d10">CN.D02.A5</data>
  <data key="d11"></data>
</node>
