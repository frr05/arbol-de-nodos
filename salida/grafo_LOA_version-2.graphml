  <data key="d4">LOA.D07.A1</data>
  <data key="d5">2012-10-22</data>
  <data key="d6">436.7</data>
  <data key="d7">-232.2</data>
  <data key="d8">b)  Número de vehículos registrados fuera de la Longitud de Cola de Vehículos
