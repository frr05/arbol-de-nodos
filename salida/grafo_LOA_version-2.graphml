  <data key="d2">2.6.2 PLAN DE MEDIDAS DE CONTROL DE ACCIDENTES O CONTINGENCIAS DURANTE LA ETAPA DE EXPLOTACIÓN</data>
  <data key="d3">BL:2.6</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">181.79999999999998</data>
