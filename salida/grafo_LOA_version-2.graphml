  <data key="d11"></data>
</node>
<node id="BL:2.2.2.8">
  <data key="d0">articulo</data>
  <data key="d1">2.2.2.8</data>
  <data key="d2">2.2.2.8 PROYECTO DE SEÑALIZACIÓN, DEMARCACIÓN Y SEGURIDAD VIAL</data>
  <data key="d3">BL:2.2</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">451.5</data>
  <data key="d7">219.0</data>
  <data key="d8"></data>
  <data key="d9">3</data>
  <data key="d10">LOA.D01.A1</data>
