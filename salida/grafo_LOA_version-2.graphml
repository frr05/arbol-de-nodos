  <data key="d5">2012-10-22</data>
  <data key="d6">261.5</data>
  <data key="d7">353.7</data>
  <data key="d8">o Teléfono S.O.S. o número de teléfono de origen de la llamada, según corresponda.
o Hora, día y duración de la llamada.
o Grabación de los llamados.</data>
  <data key="d9">10</data>
  <data key="d10">LOA.D07.A1</data>
  <data key="d11"></data>
</node>
