  <data key="d8">Las oficinas se deberán construir y equipar, utilizando equipos y sistemas que permitan reducir
el consumo de agua, electricidad, calefacción, etc.</data>
  <data key="d9">1</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
