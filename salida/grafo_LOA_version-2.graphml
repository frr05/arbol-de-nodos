<node id="BL:1.8.7">
  <data key="d0">articulo</data>
  <data key="d1">1.8.7</data>
  <data key="d2">1.8.7 INFRAESTRUCTURA PREEXISTENTE QUE SE ENTREGA AL CONCESIONARIO</data>
  <data key="d3">BL:1.8</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">-475.4</data>
  <data key="d7">-71.2</data>
