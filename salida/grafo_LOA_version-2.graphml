  <data key="d2">inciso 14</data>
  <data key="d3">BL:2.2</data>
  <data key="d4">LOA.D01.A1</data>
  <data key="d5">2012-06-13</data>
  <data key="d6">451.0</data>
  <data key="d7">223.8</data>
  <data key="d8">La Sociedad Concesionaria deberá considerar el empleo de Señales Verticales y
Demarcaciones, de acuerdo al siguiente detalle:
Señales Verticales</data>
  <data key="d9">3</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
