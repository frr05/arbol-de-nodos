  <data key="d4">LOA.D01.A1</data>
  <data key="d5">2012-06-13</data>
  <data key="d6">-318.90000000000003</data>
  <data key="d7">-867.1</data>
  <data key="d8">Confiabilidad: Tanto los equipos como el software del sistema electrónico de cobro, deberán ser productos comprobados, asegurando un bajo riesgo técnico y una operación segura.</data>
  <data key="d9">58</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
