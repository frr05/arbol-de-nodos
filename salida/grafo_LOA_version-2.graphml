  <data key="d8">Instalación:
Las conexiones eléctricas deben ser indicadas mediante plano en Autocad y todas bajo norma
SEC.</data>
  <data key="d9">3</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
