  <data key="d2">inciso 4</data>
  <data key="d3">BL:2.7</data>
  <data key="d4">LOA.D08.A2</data>
  <data key="d5">2012-11-21</data>
  <data key="d6">433.7</data>
  <data key="d7">8.200000000000001</data>
  <data key="d8">“La no implementación de las medidas del Plan de Manejo Ambiental y Territorial Mínimo, hará
incurrir a la Sociedad Concesionaria en la multa que se establezca según el artículo 1.8.11 de las
presentes Bases de Licitación.”</data>
  <data key="d9">6</data>
  <data key="d10">LOA.D08.A2</data>
  <data key="d11"></data>
</node>
