  <data key="d4">LOA.D01.A1</data>
  <data key="d5">2012-06-13</data>
  <data key="d6">454.90000000000003</data>
  <data key="d7">219.29999999999998</data>
  <data key="d8">En todas las señales informativas del tipo Preseñalización (IP) y de Dirección (ID), deberá
quedar incorporado el rol de la ruta principal y de la ruta a la que se accederá.</data>
  <data key="d9">3</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.2.8-i21">
  <data key="d0">inciso</data>
  <data key="d1">2.2.2.8 ¶21</data>
  <data key="d2">inciso 21</data>
  <data key="d3">BL:2.2</data>
  <data key="d4">LOA.D01.A1</data>
  <data key="d5">2012-06-13</data>
  <data key="d6">454.7</data>
  <data key="d7">221.4</data>
  <data key="d8">Demarcaciones</data>
  <data key="d9">3</data>
  <data key="d10">LOA.D01.A1</data>
