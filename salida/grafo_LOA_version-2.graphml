  <data key="d5">2012-11-21</data>
  <data key="d6">-113.3</data>
  <data key="d7">42.2</data>
  <data key="d8">42. Se adiciona el artículo 2.3.1.8.4 “MIRADORES”, cuyo texto es el siguiente:</data>
  <data key="d9">10</data>
  <data key="d10">LOA.D08.A2</data>
  <data key="d11"></data>
</node>
<node id="BL:2.3.1.9">
  <data key="d0">articulo</data>
