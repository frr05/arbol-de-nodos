  <data key="d4">LOA.D01.A1</data>
  <data key="d5">2012-06-13</data>
  <data key="d6">834.0</data>
  <data key="d7">64.0</data>
  <data key="d8">CONTINGENCIAS | ACCIONES
| - Dar aviso inmediato al Inpector Fiscal de lo ocurrido, sus
consecuencias y las medidas a implementar.</data>
  <data key="d9">0</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
