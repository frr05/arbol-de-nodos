  <data key="d5">2012-06-13</data>
  <data key="d6">415.7</data>
  <data key="d7">-6.0</data>
  <data key="d8">• Donde dice:
“...y refinación, transporte, alamcenamiento, distribución y abastecimiento...”
“...y refinación, transporte, almacenamiento, distribución y abastecimiento...”</data>
  <data key="d9">-1</data>
  <data key="d10">LOA.D02.A1</data>
  <data key="d11"></data>
</node>
