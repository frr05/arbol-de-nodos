  <data key="d11"></data>
</node>
<node id="BL:2.2.3.1">
  <data key="d0">articulo</data>
  <data key="d1">2.2.3.1</data>
  <data key="d2">2.2.3.1 INTRODUCCIÓN</data>
  <data key="d3">BL:2.2</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">63.3</data>
