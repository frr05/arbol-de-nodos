<node id="BL:2.4.3.9.1-i1">
  <data key="d0">inciso</data>
  <data key="d1">2.4.3.9.1 ¶1</data>
  <data key="d2">inciso 1</data>
  <data key="d3">BL:2.4</data>
  <data key="d4">LOA.D01.A1</data>
  <data key="d5">2012-06-13</data>
  <data key="d6">164.0</data>
  <data key="d7">512.0</data>
  <data key="d8">El Área de Concesión debe mantenerse siempre libre de todo material extraño que atente
contra la estética general de la obra, realizando los trabajos necesarios para quitarlos.</data>
  <data key="d9">1</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
