  <data key="d5">2012-06-13</data>
  <data key="d6">251.4</data>
  <data key="d7">-158.9</data>
  <data key="d8">El Sistema de Atención a Clientes deberá ser capaz de:</data>
  <data key="d9">61</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.3.6.5-i3">
