  <data key="d7">837.0999999999999</data>
  <data key="d8">Plazo de Restauración: Este indicador de servicio no tiene plazo de restauración. El incumplimiento del umbral hará incurrir a la Sociedad Concesionaria en la multa siguiente.</data>
  <data key="d9">2</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
