  <data key="d4">LOA.D01.A1</data>
  <data key="d5">2012-06-13</data>
  <data key="d6">40.4</data>
  <data key="d7">670.6999999999999</data>
  <data key="d8">En caso de no existir red eléctrica para la conservación de la carga se debe utilizar un panel
solar de 100 watt.</data>
  <data key="d9">3</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
