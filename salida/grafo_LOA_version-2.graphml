  <data key="d5">2012-06-13</data>
  <data key="d6">-522.2</data>
  <data key="d7">32.5</data>
  <data key="d8">El incumplimiento de cualquiera de estas obligaciones hará incurrir a la Sociedad
Concesionaria en la multa que se establezca en el artículo 1.8.11 de las presentes Bases de
Licitación.</data>
  <data key="d9">10</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.4.5.2">
  <data key="d0">articulo</data>
