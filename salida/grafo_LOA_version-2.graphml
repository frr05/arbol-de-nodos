  <data key="d2">inciso 10</data>
  <data key="d3">BL:2.4</data>
  <data key="d4">LOA.D01.A1</data>
  <data key="d5">2012-06-13</data>
  <data key="d6">-633.1999999999999</data>
  <data key="d7">299.5</data>
  <data key="d8">Método de Constatación: Inspección visual, cinta métrica, vara de 5m.</data>
  <data key="d9">1</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
