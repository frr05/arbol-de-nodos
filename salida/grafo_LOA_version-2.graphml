  <data key="d2">inciso 6</data>
  <data key="d3">BL:1.11</data>
  <data key="d4">LOA.D01.A1</data>
  <data key="d5">2012-06-13</data>
  <data key="d6">667.5</data>
  <data key="d7">-439.8</data>
  <data key="d8">Una vez verificado el cabal cumplimiento del Contrato, se dará curso al documento de término
de la concesión y al Acta de Entrega.</data>
  <data key="d9">0</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
