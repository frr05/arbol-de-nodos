  <data key="d11"></data>
</node>
<node id="BL:2.7.1">
  <data key="d0">articulo</data>
  <data key="d1">2.7.1</data>
  <data key="d2">2.7.1 PLAN DE MANEJO AMBIENTAL Y TERRITORIAL MÍNIMO DURANTE LA ETAPA DE CONSTRUCCIÓN</data>
  <data key="d3">BL:2.7</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">437.8</data>
  <data key="d7">6.3</data>
  <data key="d8"></data>
  <data key="d9">6</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.7.1-i1">
  <data key="d0">inciso</data>
  <data key="d1">2.7.1 ¶1</data>
  <data key="d2">inciso 1</data>
  <data key="d3">BL:2.7</data>
  <data key="d4">LOA.D01.A1</data>
  <data key="d5">2012-06-13</data>
  <data key="d6">439.40000000000003</data>
  <data key="d7">6.3</data>
  <data key="d8">El Plan de Manejo Ambiental y Territorial Mínimo durante la Etapa de Construcción está
constituido por las medidas de manejo ambiental y territorial señaladas en los artículos 2.7.1.1
al 2.7.1.12, ambos inclusive de las presentes Bases de Licitación. Para cada componente
ambiental se indican las medidas de mitigación, reparación, compensación y de prevención de
riesgos, mínimas necesarias que la Sociedad Concesionaria debe aplicar durante la Etapa de
Construcción.</data>
  <data key="d9">6</data>
  <data key="d10">LOA.D01.A1</data>
  <data key="d11"></data>
</node>
