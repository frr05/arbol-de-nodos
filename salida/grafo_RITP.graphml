  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">580.0999999999999</data>
  <data key="d7">61.699999999999996</data>
  <data key="d8">- Huminación</data>
</node>
<node id="BL:2.5-i3">
  <data key="d0">inciso</data>
  <data key="d1">2.5 ¶3</data>
  <data key="d2">inciso 3</data>
  <data key="d3">BL:2.5</data>
  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">579.8</data>
