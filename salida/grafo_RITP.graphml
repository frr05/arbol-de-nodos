<node id="BL:2.11">
  <data key="d0">capitulo</data>
  <data key="d1">2.11</data>
  <data key="d2">2.11 PLAN DE MANEJO AMBIENTAL MINIMO DURANTE LA EXPLOTACION =</data>
  <data key="d3">BL:2.11</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">167.1</data>
