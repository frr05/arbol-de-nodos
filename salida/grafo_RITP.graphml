  <data key="d2">inciso 16</data>
  <data key="d3">BL:1.8</data>
  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">557.6999999999999</data>
  <data key="d7">213.60000000000002</data>
  <data key="d8">Fiscalizar el cumplimiento del Programa Anual de Conservación, aprobado por el Inspector Fiscal,
señalado en el artículo 1.9.2.4 de las presentes Bases de Licitación, sin perjuicio de la atribución de
otros organismos competentes;</data>
</node>
<node id="BL:1.8.1-i17">
  <data key="d0">inciso</data>
