  <data key="d5">2001-08-01</data>
  <data key="d6">551.2</data>
  <data key="d7">209.3</data>
  <data key="d8">Enviar mensualmente un informe ejecutivo al DGOP, que indique el estado y grado de avance del
contrato de concesión.</data>
</node>
<node id="BL:1.8.1-i19">
  <data key="d0">inciso</data>
