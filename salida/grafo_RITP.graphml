  <data key="d2">inciso 12</data>
  <data key="d3">BL:1.14</data>
  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">399.4</data>
  <data key="d7">333.5</data>
  <data key="d8">Los valores de los peritajes serán establecidos en Unidades de Fomento.</data>
</node>
<node id="BL:1.14.2.3.3-i13">
  <data key="d0">inciso</data>
  <data key="d1">1.14.2.3.3 ¶13</data>
