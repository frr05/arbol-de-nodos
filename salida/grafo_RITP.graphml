  <data key="d5">2001-08-01</data>
  <data key="d6">551.9</data>
  <data key="d7">207.9</data>
  <data key="d8">Revisar la información estadística entregada por el Concesionario;</data>
</node>
<node id="BL:1.8.1-i32">
  <data key="d0">inciso</data>
  <data key="d1">1.8.1 ¶32</data>
