  <data key="d4">RITP.D01.A1</data>
  <data key="d5">2001-08-01</data>
  <data key="d6">557.5</data>
  <data key="d7">208.9</data>
  <data key="d8">Abrir y llevar un Libro de Construcción de la Obra desde que sea designado;</data>
</node>
<node id="BL:1.8.1-i18">
  <data key="d0">inciso</data>
