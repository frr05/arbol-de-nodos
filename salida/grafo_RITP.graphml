  <data key="d0">acto_posterior</data>
  <data key="d1">F0005</data>
  <data key="d2">Puesta en servicio N°4067 (2005-12-26)</data>
  <data key="d3">BL:1.10</data>
  <data key="d4">RITP.D07.A1</data>
  <data key="d5">2005-12-26</data>
  <data key="d6">168.1</data>
  <data key="d7">156.5</data>
  <data key="d8">1. AUTORÍZASE la Puesta en Servicio Definitiva de la obra pública fiscal
denominada “Ruta Interportuaria Talcahuano — Penco por isla Rocuant”, a contar
- de las 00:00 hrs. del día siguiente a la fecha de la presente resolución.</data>
</node>
<node id="BL:1.10.4">
  <data key="d0">articulo</data>
