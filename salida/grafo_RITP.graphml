  <data key="d5">2001-08-01</data>
  <data key="d6">558.8</data>
  <data key="d7">213.10000000000002</data>
  <data key="d8">Fiscalizar los pagos que deba realizar la Sociedad Concesionaria al MOP de acuerdo a lo señalado en
las presentes Bases de Licitación;</data>
</node>
<node id="BL:1.8.1-i31">
  <data key="d0">inciso</data>
