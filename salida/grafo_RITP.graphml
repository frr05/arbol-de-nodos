  <data key="d5">2001-08-01</data>
  <data key="d6">150.0</data>
  <data key="d7">328.2</data>
  <data key="d8">La tecnología para el cobro del peaje bajo este sistema debe ser Control de Accesos Manual.</data>
</node>
