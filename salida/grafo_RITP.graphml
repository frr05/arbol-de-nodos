  <data key="d8">El adjudicatario deberá mantener siempre vigente la Garantía de Seriedad de la Oferta hasta que ésta sea
sustituida por la garantía de construcción.</data>
</node>
<node id="BL:1.5.7-i4">
  <data key="d0">inciso</data>
