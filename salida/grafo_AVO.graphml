  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">242.29999999999998</data>
  <data key="d7">-27.7</data>
  <data key="d8"></data>
  <data key="d9">92</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
