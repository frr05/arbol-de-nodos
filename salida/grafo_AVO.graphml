  <data key="d6">-652.0</data>
  <data key="d7">379.7</data>
  <data key="d8"></data>
  <data key="d9">86</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.3.7.8-i1">
  <data key="d0">inciso</data>
  <data key="d1">2.2.3.7.8 ¶1</data>
  <data key="d2">inciso 1</data>
  <data key="d3">BL:2.2</data>
  <data key="d4">AVO.D12.A1</data>
  <data key="d5">2016-09-15</data>
  <data key="d6">-649.4</data>
  <data key="d7">380.09999999999997</data>
  <data key="d8">“Se deberá considerar que todos los datos son cargados desde y hacia el Centro de
Operaciones, el cual enviará o recibirá información desde el servidor de Puntos de Cobro.
Para efectos de operación se deberán considerar, a lo menos, dos formas de transmisión:</data>
  <data key="d9">86</data>
  <data key="d10">AVO.D12.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.3.7.8-i2">
  <data key="d0">inciso</data>
  <data key="d1">2.2.3.7.8 ¶2</data>
  <data key="d2">inciso 2</data>
  <data key="d3">BL:2.2</data>
  <data key="d4">AVO.D12.A1</data>
  <data key="d5">2016-09-15</data>
  <data key="d6">-650.4</data>
  <data key="d7">379.59999999999997</data>
  <data key="d8">• A solicitud.</data>
  <data key="d9">86</data>
  <data key="d10">AVO.D12.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.3.7.8-i3">
  <data key="d0">inciso</data>
  <data key="d1">2.2.3.7.8 ¶3</data>
  <data key="d2">inciso 3</data>
  <data key="d3">BL:2.2</data>
  <data key="d4">AVO.D12.A1</data>
  <data key="d5">2016-09-15</data>
  <data key="d6">-648.7</data>
  <data key="d7">380.8</data>
  <data key="d8">• Automático o en línea.”</data>
  <data key="d9">86</data>
  <data key="d10">AVO.D12.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.3.7.8-i4">
  <data key="d0">inciso</data>
  <data key="d1">2.2.3.7.8 ¶4</data>
