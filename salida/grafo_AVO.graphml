  <data key="d3">BL:1.14</data>
  <data key="d4">AVO.D12.A1</data>
  <data key="d5">2016-09-15</data>
  <data key="d6">634.6</data>
  <data key="d7">495.8</data>
  <data key="d8">“Tabla N° 12: Estructura Tarifaria Inicial
Sentido | Tipo de Día | Período | Tipo de Tarifa
Príncipe de Gales – Los Presidentes | Laboral | 07:30 a 09:30 | TBP
Los Presidentes - Príncipe de Gales | Laboral | 07:30 a 09:30 | TBP
Príncipe de Gales – Los Presidentes | Laboral | 17:30 a 19:30 | TBP
Los Presidentes - Príncipe de Gales | Laboral | 17:30 a 19:30 | TBP</data>
  <data key="d9">28</data>
  <data key="d10">AVO.D12.A1</data>
  <data key="d11"></data>
</node>
