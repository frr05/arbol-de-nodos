  <data key="d2">inciso 5</data>
  <data key="d3">BL:2.4</data>
  <data key="d4">AVO.D11.A1</data>
  <data key="d5"></data>
  <data key="d6">-768.5999999999999</data>
  <data key="d7">-464.9</data>
  <data key="d8">La mantención del sistema y la recolección de los datos serán de cuenta de la Sociedad
Concesionaria durante toda la concesión.</data>
  <data key="d9">10</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
