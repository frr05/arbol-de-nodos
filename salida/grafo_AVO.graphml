<node id="BL:2.4.6.5">
  <data key="d0">articulo</data>
  <data key="d1">2.4.6.5</data>
  <data key="d2">2.4.6.5 ÍNDICE DEL SERVICIO PRESTADO Y DESEMPEÑO OPERACIONAL</data>
  <data key="d3">BL:2.4</data>
