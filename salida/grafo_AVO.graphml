<node id="BL:1.12.1">
  <data key="d0">articulo</data>
  <data key="d1">1.12.1</data>
  <data key="d2">1.12.1 PAGOS AL CONCESIONARIO</data>
  <data key="d3">BL:1.12</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">449.2</data>
  <data key="d7">230.7</data>
  <data key="d8"></data>
  <data key="d9">11</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
