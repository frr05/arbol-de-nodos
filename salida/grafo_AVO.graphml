  <data key="d2">inciso 7</data>
  <data key="d3">BL:1.9</data>
  <data key="d4">AVO.D11.A1</data>
  <data key="d5"></data>
  <data key="d6">26.599999999999998</data>
  <data key="d7">502.70000000000005</data>
  <data key="d8">Para la aprobación de las Modificaciones a los Proyectos de Ingeniería propuestas por el
MOP o la Sociedad Concesionaria, prevalecerá el criterio del mejoramiento del Proyecto
concesionado en su globalidad por sobre la modificación en particular.</data>
  <data key="d9">6</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:1.9.1.1-i8">
  <data key="d0">inciso</data>
