  <data key="d5"></data>
  <data key="d6">-18.5</data>
  <data key="d7">-762.0</data>
  <data key="d8">Cualquier liquidación de las Compañías de Seguros que se realice con cargo a esta póliza
deberá ser presentada al Inspector Fiscal para su aprobación.</data>
  <data key="d9">7</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
