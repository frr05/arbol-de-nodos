  <data key="d5"></data>
  <data key="d6">-3.0</data>
  <data key="d7">-363.09999999999997</data>
  <data key="d8"></data>
  <data key="d9">6</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.3.1.25-i1">
  <data key="d0">inciso</data>
  <data key="d1">2.3.1.25 ¶1</data>
  <data key="d2">inciso 1</data>
  <data key="d3">BL:2.3</data>
