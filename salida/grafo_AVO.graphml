  <data key="d5"></data>
  <data key="d6">223.5</data>
  <data key="d7">-395.6</data>
  <data key="d8">Donde,
t : Año calendario de explotación contabilizado desde el 1º de enero del año de
la Puesta en Servicio Provisoria de las Obras.</data>
  <data key="d9">10</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
