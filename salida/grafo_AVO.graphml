  <data key="d2">1.14.7 FACTORES POR PERÍODOS</data>
  <data key="d3">BL:1.14</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">90.1</data>
  <data key="d7">128.5</data>
  <data key="d8"></data>
  <data key="d9">10</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
