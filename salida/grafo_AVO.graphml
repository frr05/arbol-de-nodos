  <data key="d7">-28.0</data>
  <data key="d8"></data>
  <data key="d9">14</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.3.8.1">
  <data key="d0">articulo</data>
  <data key="d1">2.2.3.8.1</data>
  <data key="d2">2.2.3.8.1 INTRODUCCIÓN</data>
  <data key="d3">BL:2.2</data>
