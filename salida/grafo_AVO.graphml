  <data key="d2">inciso 5</data>
  <data key="d3">BL:2.4</data>
  <data key="d4">AVO.D11.A1</data>
  <data key="d5"></data>
  <data key="d6">128.6</data>
  <data key="d7">590.4000000000001</data>
  <data key="d8">NPSC = (C1xPC1) + (C2xPC2) + (C3xPC3) + (C4xPC4) (3)</data>
  <data key="d9">16</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
