  <data key="d5">2017-02-27</data>
  <data key="d6">-34.0</data>
  <data key="d7">-417.4</data>
  <data key="d8">“3. Inventario de explotación incorporado al Sistema BIM, a que se refiere el artículo
1.9.1.3 de las presentes Bases de Licitación.”</data>
  <data key="d9">3</data>
  <data key="d10">AVO.D16.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.4.1.1-ins1">
  <data key="d0">instruccion</data>
  <data key="d1">instrucción 1 (Circular aclaratoria N°5 …</data>
  <data key="d2">instrucción 1 (Circular aclaratoria N°5 (2017-02-27))</data>
