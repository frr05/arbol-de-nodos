  <data key="d5"></data>
  <data key="d6">-773.0</data>
  <data key="d7">-460.4</data>
  <data key="d8">$\overline{v_p}$ : Corresponde a la velocidad media de la pista “p”, de la sección “i” en el Período Horario “t”.</data>
  <data key="d9">10</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
