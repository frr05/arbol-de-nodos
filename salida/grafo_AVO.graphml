  <data key="d4">AVO.D11.A1</data>
  <data key="d5"></data>
  <data key="d6">-540.6</data>
  <data key="d7">-425.3</data>
  <data key="d8">Toda información que la Sociedad Concesionaria deba entregar a cualquier organismo,
institución o servicio, deberá ser coincidente con la información que se entrega al
Inspector Fiscal.</data>
  <data key="d9">0</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
