  <data key="d5"></data>
  <data key="d6">-128.70000000000002</data>
  <data key="d7">-891.7</data>
  <data key="d8">El indicador será calculado por la siguiente ecuación:</data>
  <data key="d9">1</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
