  <data key="d8">La interfase desde túnel minero a superficie se materializará a través de excavaciones tipo
trinchera, que se denominan escotillas.</data>
  <data key="d9">1</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.2.2.3-i2">
