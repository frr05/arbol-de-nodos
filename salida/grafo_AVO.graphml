  <data key="d3">BL:1.7</data>
  <data key="d4">AVO.D11.A1</data>
  <data key="d5"></data>
  <data key="d6">-0.8</data>
  <data key="d7">-139.8</data>
  <data key="d8">Para los efectos de lo dispuesto en el inciso 4 del artículo 21 de la Ley de Concesiones, será necesario que el cesionario cumpla con los requisitos establecidos en las presentes Bases de Licitación.</data>
  <data key="d9">4</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:1.7.7.5-i4">
  <data key="d0">inciso</data>
