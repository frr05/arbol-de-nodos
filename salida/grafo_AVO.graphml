<node id="BL:2.2.2.4">
  <data key="d0">articulo</data>
  <data key="d1">2.2.2.4</data>
  <data key="d2">2.2.2.4 DISEÑO DE PAVIMENTOS</data>
  <data key="d3">BL:2.2</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">715.0</data>
  <data key="d7">6.4</data>
  <data key="d8"></data>
  <data key="d9">4</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
