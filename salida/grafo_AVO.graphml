  <data key="d0">inciso</data>
  <data key="d1">2.4.6.3.1 ¶4</data>
  <data key="d2">inciso 4</data>
  <data key="d3">BL:2.4</data>
  <data key="d4">AVO.D11.A1</data>
  <data key="d5"></data>
  <data key="d6">126.6</data>
  <data key="d7">590.7</data>
  <data key="d8">c) Nivel de Prestación del Servicio de Conservación: se calculará mediante la
siguiente ecuación.</data>
  <data key="d9">16</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
