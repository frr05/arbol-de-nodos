  <data key="d7">128.8</data>
  <data key="d8">18 – TramRCA   si TramRCA &lt; 18
0   si TramRCA ≥ 18
En que:</data>
  <data key="d9">6</data>
  <data key="d10">AVO.D18.A1</data>
  <data key="d11"></data>
</node>
