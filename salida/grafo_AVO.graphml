<node id="BL:2.4.5.4">
  <data key="d0">articulo</data>
  <data key="d1">2.4.5.4</data>
  <data key="d2">2.4.5.4 SERVICIO DE GESTIÓN DE COBRO Y FACTURACIÓN</data>
  <data key="d3">BL:2.4</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">544.5</data>
  <data key="d7">-644.3</data>
  <data key="d8"></data>
