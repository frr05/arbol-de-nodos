  <data key="d0">capitulo</data>
  <data key="d1">1.10</data>
  <data key="d2">1.10 ETAPA DE EXPLOTACIÓN</data>
  <data key="d3">BL:1.10</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">333.7</data>
  <data key="d7">83.2</data>
  <data key="d8"></data>
  <data key="d9">-1</data>
  <data key="d10">AVO.D11.A1</data>
