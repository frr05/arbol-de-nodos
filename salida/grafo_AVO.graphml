  <data key="d5">2017-04-26</data>
  <data key="d6">164.89999999999998</data>
  <data key="d7">130.6</data>
  <data key="d8">TramRCA: Corresponde al número de meses transcurridos entre el ingreso
al SEIA del EIA del Proyecto y la obtención de la RCA
favorable del EIA del Proyecto. Dicho valor se determinará de
acuerdo a la siguiente fórmula, la cual será redondeada a su
entero superior más cercano:</data>
  <data key="d9">6</data>
  <data key="d10">AVO.D18.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:1.9.2.6-i5">
  <data key="d0">inciso</data>
  <data key="d1">1.9.2.6 ¶5</data>
  <data key="d2">inciso 5</data>
  <data key="d3">BL:1.9</data>
  <data key="d4">AVO.D18.A1</data>
  <data key="d5">2017-04-26</data>
  <data key="d6">165.9</data>
  <data key="d7">131.20000000000002</data>
  <data key="d8">TramRCA (meses) = [ RCA Proyecto (fecha) – Ingreso EIA del Proyecto (fecha) / 30 ]</data>
  <data key="d9">6</data>
  <data key="d10">AVO.D18.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:1.9.2.6-i6">
