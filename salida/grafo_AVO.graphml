  <data key="d2">inciso 9</data>
  <data key="d3">BL:2.7</data>
  <data key="d4">AVO.D11.A1</data>
  <data key="d5"></data>
  <data key="d6">433.09999999999997</data>
  <data key="d7">104.0</data>
  <data key="d8">El Plan de seguimiento de este componente, deberá ser informado de acuerdo a lo
dispuesto en el artículo 2.7.1.12 de las presentes Bases de Licitación.</data>
  <data key="d9">13</data>
  <data key="d10">AVO.D11.A1</data>
  <data key="d11"></data>
</node>
