  <data key="d6">630.0</data>
  <data key="d7">-513.4</data>
  <data key="d8">Se deberá dotar al sistema de una modularidad, donde la totalidad del equipamiento tiene sus funciones claras y delimitadas. Para los elementos de funcionalidad múltiple, se deberá mantener en los Puntos de Cobro, toda la información para proceder a una reconfiguración en caso de reemplazo.</data>
  <data key="d9">48</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.3.12.4">
  <data key="d0">articulo</data>
  <data key="d1">2.2.3.12.4</data>
  <data key="d2">2.2.3.12.4 CAPACIDAD DE EXPANSIÓN</data>
  <data key="d3">BL:2.2</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">634.7</data>
  <data key="d7">-510.49999999999994</data>
  <data key="d8"></data>
  <data key="d9">49</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
