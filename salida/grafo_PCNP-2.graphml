  <data key="d6">-115.7</data>
  <data key="d7">-311.40000000000003</data>
  <data key="d8">Los pagos que el Concesionario deba realizar al Estado se harán mediante Vales Vista
extendidos a nombre del Director General de Obras Públicas.</data>
  <data key="d9">7</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
