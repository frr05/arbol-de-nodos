<node id="BL:1.12.3.3.3">
  <data key="d0">articulo</data>
  <data key="d1">1.12.3.3.3</data>
  <data key="d2">1.12.3.3.3 COMPENSACIÓN O INDEMNIZACIÓN POR NUEVAS INVERSIONES</data>
