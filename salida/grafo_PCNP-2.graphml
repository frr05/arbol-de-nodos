  <data key="d5"></data>
  <data key="d6">789.6</data>
  <data key="d7">-590.0</data>
  <data key="d8">La corta de vegetación en zonas urbanas deberá atenerse a lo dispuesto en las ordenanzas
municipales respectivas.</data>
  <data key="d9">97</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
