  <data key="d6">631.1</data>
  <data key="d7">-510.4</data>
  <data key="d8"></data>
  <data key="d9">3</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.3.12-i1">
  <data key="d0">inciso</data>
  <data key="d1">2.2.3.12 ¶1</data>
