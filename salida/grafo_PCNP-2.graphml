  <data key="d7">699.8</data>
  <data key="d8">74. Semestre: Período comprendido entre el 1º de enero y el 30 de junio o el período
comprendido entre el 1º de julio y el 31 de diciembre de cada año.</data>
  <data key="d9">3</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
