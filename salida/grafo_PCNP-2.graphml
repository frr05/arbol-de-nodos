  <data key="d7">706.3000000000001</data>
  <data key="d8">75. SEREMI: Secretaría Regional Ministerial o Secretario Regional Ministerial, según
corresponda, del Ministerio que en cada caso se indique.</data>
  <data key="d9">3</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:1.2.2-i72">
  <data key="d0">inciso</data>
