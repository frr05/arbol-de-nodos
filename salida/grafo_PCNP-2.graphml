  <data key="d2">inciso 7</data>
  <data key="d3">BL:2.2</data>
  <data key="d4">PCNP-2.D02.A1</data>
  <data key="d5"></data>
  <data key="d6">-556.9</data>
  <data key="d7">-716.0999999999999</data>
  <data key="d8">• Conexión con el MOP.
• Y todo lo necesario para el buen funcionamiento del Sistema de Cobro de Peaje.</data>
  <data key="d9">69</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
