  <data key="d3">BL:2.4</data>
  <data key="d4">PCNP-2.D02.A1</data>
  <data key="d5"></data>
  <data key="d6">-272.3</data>
  <data key="d7">308.40000000000003</data>
  <data key="d8"></data>
  <data key="d9">92</data>
