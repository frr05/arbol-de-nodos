  <data key="d8">El Concesionario será el único responsable de los trabajos topográficos que realice y de su
compatibilidad con los sistemas de coordenadas utilizados por el Instituto Geográfico Militar
(IGM).</data>
  <data key="d9">12</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
