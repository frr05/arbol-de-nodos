  <data key="d7">-630.8000000000001</data>
  <data key="d8">- Servidores de Puntos de Cobro</data>
  <data key="d9">6</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
