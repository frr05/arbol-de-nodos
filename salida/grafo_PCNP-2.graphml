  <data key="d5"></data>
  <data key="d6">-8.200000000000001</data>
  <data key="d7">709.8</data>
  <data key="d8">5. Año Calendario: Período de doce meses consecutivos que se inicia el 1° de enero y
termina el día 31 de diciembre.</data>
  <data key="d9">3</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
