<node id="BL:2.4.6">
  <data key="d0">articulo</data>
  <data key="d1">2.4.6</data>
  <data key="d2">2.4.6 NIVEL DE SERVICIO DE LA CONCESIÓN DURANTE LA FASE 2 DE LA ETAPA DE EXPLOTACIÓN</data>
  <data key="d3">BL:2.4</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">304.0</data>
  <data key="d7">185.70000000000002</data>
  <data key="d8"></data>
