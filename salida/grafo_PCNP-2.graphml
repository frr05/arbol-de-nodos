  <data key="d2">1.8.17 PROPIEDAD INTELECTUAL</data>
  <data key="d3">BL:1.8</data>
  <data key="d4"></data>
  <data key="d5"></data>
  <data key="d6">-82.10000000000001</data>
  <data key="d7">-179.79999999999998</data>
  <data key="d8"></data>
