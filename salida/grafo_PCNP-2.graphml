  <data key="d2">inciso 22</data>
  <data key="d3">BL:2.2</data>
  <data key="d4">PCNP-2.D02.A1</data>
  <data key="d5"></data>
  <data key="d6">-429.8</data>
  <data key="d7">-631.1</data>
  <data key="d8">➢ Nivel de Gestión</data>
  <data key="d9">6</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
<node id="BL:2.2.3.13-i23">
  <data key="d0">inciso</data>
  <data key="d1">2.2.3.13 ¶23</data>
  <data key="d2">inciso 23</data>
  <data key="d3">BL:2.2</data>
