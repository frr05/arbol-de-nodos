  <data key="d5"></data>
  <data key="d6">-1.2</data>
  <data key="d7">710.6</data>
  <data key="d8">68. Reglamento de la Ley de Concesiones: Es el Reglamento de la Ley de Concesiones
aprobado por Decreto Supremo MOP Nº 956 de 1997 y sus modificaciones.</data>
  <data key="d9">3</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
