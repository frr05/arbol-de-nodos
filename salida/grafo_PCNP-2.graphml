  <data key="d5"></data>
  <data key="d6">-377.2</data>
  <data key="d7">-313.40000000000003</data>
  <data key="d8"></data>
  <data key="d9">2</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
