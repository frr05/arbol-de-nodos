  <data key="d6">-555.3000000000001</data>
  <data key="d7">-718.5</data>
  <data key="d8">• Control de las alarmas del Sistema de Cobro de Peaje.</data>
  <data key="d9">69</data>
  <data key="d10">PCNP-2.D02.A1</data>
  <data key="d11"></data>
</node>
